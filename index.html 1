 Guided Sections&lt;/h3&gt;&lt;div class=\&quot;muted\&quot;&gt;Design → install → wire → startup → troubleshoot → commission.&lt;/div&gt;&lt;/div&gt;\n  &lt;div class=\&quot;project\&quot;&gt;&lt;span class=\&quot;badge-mini\&quot;&gt;FIELD TOOLS&lt;/span&gt;&lt;h3 style=\&quot;margin:8px 0 4px\&quot;&gt;Interactive + Saved&lt;/h3&gt;&lt;div class=\&quot;muted\&quot;&gt;Project data, calculators, checklists, diagrams, and persistent progress.&lt;/div&gt;&lt;/div&gt;\n&lt;/div&gt;&lt;div class=\&quot;phases\&quot; id=\&quot;phases\&quot;&gt;&lt;/div&gt;&lt;div class=\&quot;panel\&quot;&gt;&lt;div class=\&quot;panel-head\&quot;&gt;&lt;h2 id=\&quot;phaseTitle\&quot;&gt;Overview&lt;/h2&gt;&lt;p id=\&quot;phaseText\&quot;&gt;&lt;/p&gt;&lt;/div&gt;&lt;div class=\&quot;list\&quot; id=\&quot;sectionList\&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section id=\&quot;screen-section\&quot; class=\&quot;screen\&quot;&gt;&lt;div class=\&quot;sectiontop\&quot;&gt;&lt;button class=\&quot;back\&quot; onclick=\&quot;showScreen('module')\&quot;&gt;← Module&lt;/button&gt;&lt;div&gt;&lt;h2 id=\&quot;sectionTitle\&quot;&gt;&lt;/h2&gt;&lt;p id=\&quot;sectionSub\&quot;&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=\&quot;tabs\&quot;&gt;&lt;button class=\&quot;tab active\&quot; data-tab=\&quot;learn\&quot;&gt;LEARN&lt;/button&gt;&lt;button class=\&quot;tab\&quot; data-tab=\&quot;diagram\&quot;&gt;DIAGRAM&lt;/button&gt;&lt;button class=\&quot;tab\&quot; data-tab=\&quot;calculate\&quot;&gt;CALCULATE&lt;/button&gt;&lt;button class=\&quot;tab\&quot; data-tab=\&quot;check\&quot;&gt;FIELD CHECK&lt;/button&gt;&lt;button class=\&quot;tab\&quot; data-tab=\&quot;trouble\&quot;&gt;TROUBLESHOOT&lt;/button&gt;&lt;/div&gt;&lt;div class=\&quot;pane show\&quot; id=\&quot;learn\&quot;&gt;&lt;/div&gt;&lt;div class=\&quot;pane\&quot; id=\&quot;diagram\&quot;&gt;&lt;/div&gt;&lt;div class=\&quot;pane\&quot; id=\&quot;calculate\&quot;&gt;&lt;/div&gt;&lt;div class=\&quot;pane\&quot; id=\&quot;check\&quot;&gt;&lt;/div&gt;&lt;div class=\&quot;pane\&quot; id=\&quot;trouble\&quot;&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section id=\&quot;screen-project\&quot; class=\&quot;screen\&quot;&gt;&lt;div class=\&quot;panel\&quot;&gt;&lt;div class=\&quot;panel-head\&quot;&gt;&lt;h2&gt;My Irrigation Project&lt;/h2&gt;&lt;p&gt;Saved locally on this device and reusable throughout the flagship.&lt;/p&gt;&lt;/div&gt;&lt;div class=\&quot;list\&quot;&gt;&lt;div class=\&quot;grid\&quot; id=\&quot;projectGrid\&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section id=\&quot;screen-troubleshoot\&quot; class=\&quot;screen\&quot;&gt;&lt;div class=\&quot;panel\&quot;&gt;&lt;div class=\&quot;panel-head\&quot;&gt;&lt;h2&gt;Master Troubleshooting Center&lt;/h2&gt;&lt;p&gt;Start from the symptom, follow evidence, and avoid replacing random parts because capitalism already has enough help.&lt;/p&gt;&lt;/div&gt;&lt;div class=\&quot;list\&quot;&gt;&lt;div class=\&quot;symptoms\&quot; id=\&quot;symptoms\&quot;&gt;&lt;/div&gt;&lt;div id=\&quot;tree\&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section id=\&quot;screen-commission\&quot; class=\&quot;screen\&quot;&gt;&lt;div class=\&quot;panel\&quot;&gt;&lt;div class=\&quot;panel-head\&quot;&gt;&lt;h2&gt;Final Commissioning Mode&lt;/h2&gt;&lt;p&gt;Run each subsystem, record pass/issues, and do not treat a pretty lawn as proof the buried work is correct.&lt;/p&gt;&lt;/div&gt;&lt;div class=\&quot;list\&quot;&gt;&lt;div class=\&quot;commission-grid\&quot; id=\&quot;commissionGrid\&quot;&gt;&lt;/div&gt;&lt;div class=\&quot;commission-summary\&quot; id=\&quot;commissionSummary\&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;section id=\&quot;screen-progress\&quot; class=\&quot;screen\&quot;&gt;&lt;div class=\&quot;panel\&quot;&gt;&lt;div class=\&quot;panel-head\&quot;&gt;&lt;h2&gt;Progress&lt;/h2&gt;&lt;p&gt;Completion requires both reviewed learning and field-check confirmation.&lt;/p&gt;&lt;/div&gt;&lt;div class=\&quot;list\&quot; id=\&quot;progress\&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;\n&lt;/main&gt;\n&lt;/div&gt;\n&lt;nav class=\&quot;bottom\&quot;&gt;&lt;button class=\&quot;nav active\&quot; data-screen=\&quot;module\&quot;&gt;&lt;span&gt;💧&lt;/span&gt;MODULE&lt;/button&gt;&lt;button class=\&quot;nav\&quot; data-screen=\&quot;project\&quot;&gt;&lt;span&gt;📋&lt;/span&gt;PROJECT&lt;/button&gt;&lt;button class=\&quot;nav\&quot; data-screen=\&quot;troubleshoot\&quot;&gt;&lt;span&gt;🔧&lt;/span&gt;TROUBLESHOOT&lt;/button&gt;&lt;button class=\&quot;nav\&quot; data-screen=\&quot;commission\&quot;&gt;&lt;span&gt;🧪&lt;/span&gt;COMMISSION&lt;/button&gt;&lt;button class=\&quot;nav\&quot; data-screen=\&quot;progress\&quot;&gt;&lt;span&gt;✓&lt;/span&gt;PROGRESS&lt;/button&gt;&lt;button class=\&quot;nav\&quot; onclick=\&quot;location.href='index.html'\&quot;&gt;&lt;span&gt;⌂&lt;/span&gt;FREE APP&lt;/button&gt;&lt;/nav&gt;\n&lt;script&gt;\nconst phases=[\n['overview','Overview','Understand the complete system before installing anything.',[1]],\n['design','Design','Survey, measure, test supply, zone the property, size hydraulics, and plan materials.',[2,3,4,5,6,7]],\n['layout','Layout &amp; Excavation','Transfer the design to the property and prepare safe trench routes.',[8,9]],\n['water','Water System','Build from point of connection through mainline, valves, laterals, heads, and drip.',[10,11,12,13,14,15]],\n['electrical','Electrical','Wire controller, valves, common conductor, sensors, and related controls.',[16]],\n['startup','Startup','Pressurize, flush, adjust coverage, and program.',[17,18,19]],\n['diagnostics','Diagnostics','Use symptom-first troubleshooting paths.',[21]],\n['commission','Commissioning','Backfill only after testing, then document and maintain the system.',[20,22,23,24]]\n];\nconst data=[\n['System Fundamentals &amp; Project Overview','Complete-system anatomy, zones, components, and build sequence',['How the complete system works','Mainline vs lateral lines','Zones and hydrozones','Spray, rotor, bubbler, and drip','Valve/manifold fundamentals','Controller fundamentals','Backflow protection','Installation sequence'],['Identify water source','Identify shutoff/backflow area','Choose manifold area','Choose controller area']],\n['Site Survey &amp; Measurements','Map the property before design begins',['Walk the property','Measure irrigated areas','Map hardscape','Record slopes/elevation','Separate turf, beds, trees','Choose valve/controller locations'],['Water source located','Property measured','Hardscape mapped','Elevation noted','Planting areas identified','Valve location selected','Controller location selected','!Utilities identified before excavation']],\n['Water Supply Testing','Measure flow and pressure before sizing zones',['Static pressure','Working pressure','Available flow','Bucket flow test','Pressure gauge use','Design reserve'],['Static pressure recorded','Flow test completed','Available GPM saved','Results retested if questionable']],\n['Irrigation Design &amp; Hydrozoning','Separate areas by equipment and watering demand',['What constitutes a zone','Separate turf and beds','Separate spray and rotors','Keep drip separate','Sun/shade','Slope/runoff'],['Turf zones identified','Drip zones identified','Spray/rotor separated','Sun/shade considered','Slope considered']],\n['Head Selection &amp; Coverage','Choose devices and create head-to-head coverage',['Spray bodies','Rotary nozzles','Rotors','Bubblers','Radius and arc','Head-to-head coverage','Matched precipitation'],['Head type selected','Nozzles selected','Coverage checked','Overspray minimized','Obstructions considered']],\n['Hydraulic Design &amp; Zone Sizing','Match zone demand to actual site capacity',['Zone GPM','Pipe diameter and velocity','Friction loss','Valve/fitting loss','Elevation effect','Operating pressure','Oversized zones'],['Zone GPM calculated','Flow reserve maintained','Mainline pipe type/size recorded','Lateral pipe type/size recorded','Pressure losses reviewed','Oversized zones split']],\n['Materials &amp; Parts Planning','Turn the design into a buildable parts list',['Pipe type: PVC vs polyethylene','Pipe sizing: mainline and laterals','90° and 45° elbows','Tees and reducing tees','Couplings and repair couplings','Reducers and threaded adapters','Unions, caps, plugs, risers and swing joints','Valve/manifold fittings','Backflow/valves','Valve boxes and waterproof wire connectors','Heads/nozzles','Drip transition fittings','Controller/sensors','Primer, cement and connection supplies'],['Pipe type selected','Mainline size selected','Lateral sizes selected','Elbows counted','Tees counted','Couplings/repair fittings counted','Reducers/adapters counted','Valve/manifold fittings counted','Heads/nozzles counted','Drip fittings counted','Wire/connectors counted','Tools/PPE checked']],\n['Layout &amp; Marking','Transfer the plan to the property',['Flags/paint','Head locations','Valve boxes','Pipe routes','Wire route','Hardscape crossings'],['Heads flagged','Valve boxes marked','Pipe routes marked','Wire route marked','Sleeves identified','Layout rechecked']],\n['Excavation &amp; Trenching','Prepare trenches while protecting utilities and site conditions',['Utility-locate requirements','Trench routing','Managing soil','Crossings','Sleeving','Roots','Preparing trenches'],['!Applicable utility-locate requirements addressed','Trench routes confirmed','Crossings prepared','Soil staged safely','Existing features protected']],\n['Water Connection, Shutoff &amp; Backflow','Create a serviceable protected supply path',['Point of connection','Dedicated shutoff','Backflow purpose','Common arrangements','Accessibility','Local requirements'],['Connection verified','Shutoff accessible','Backflow orientation correct','Service clearance maintained','!Local backflow requirements confirmed']],\n['Mainline Installation','Install, flush, and pressure-check the feed line',['Routing/sizing','Cutting/joining','Fittings','Isolation','Flushing','Leak testing'],['Correct pipe size','Joints completed','Route protected','Mainline flushed','Leak test passed']],\n['Valve Manifold Installation','Build an organized serviceable valve group',['Grouped vs individual valves','Flow direction','Isolation','Solenoid orientation','Valve-box spacing','Common mistakes'],['Flow direction verified','Valves accessible','Solenoids accessible','Manifold supported','Valve box fits','Zones labeled']],\n['Lateral Pipe Installation','Route each valve to its zone',['Valve-to-zone routing','Branch layouts','Tees/elbows','Pipe sizing','Swing connections','Flushing'],['Correct zone connected','Branches match plan','Fittings minimized','Laterals flushed','Ends tested before backfill']],\n['Sprinkler Head Installation','Set body, nozzle, arc, radius, and elevation',['Body placement','Elevation','Swing joints','Vertical alignment','Nozzles','Arc/radius','Low-head drainage'],['Heads level','Correct nozzle','Correct arc','Correct radius','Coverage overlap checked']],\n['Complete Drip System Installation','Install filtered and regulated low-volume distribution',['Dedicated drip zone','Filtration','Pressure regulation','Main tubing','Emitters/dripline','Tree/shrub layouts','Flush points'],['Filter installed','Regulator installed','Tubing routed','Emitters placed','Tubing anchored','Flush end accessible','Zone flushed']],\n['Controller &amp; Electrical Installation','Wire stations, common, valves, sensors, and controls',['Controller placement','Zone terminals','Common terminal','Solenoids','Multi-conductor wire','Waterproof splices','Master valve/pump concepts','Labeling'],['Controller mounted','Station wires labeled','Common labeled','Waterproof connectors used','Valve wiring tested']],\n['System Startup &amp; Flushing','Pressurize slowly and run each zone',['Initial pressurization','Mainline inspection','Manifold inspection','Lateral flushing','Zone tests','Valve closure'],['Mainline holds','Manifold dry','Every zone activates','Every zone shuts off','Laterals flushed','No visible leaks']],\n['Coverage Testing &amp; Final Adjustment','Correct dry spots, overspray, and pressure symptoms',['Visual coverage','Catch-can concept','Dry spots','Overspray','Alignment','Pressure symptoms','Runoff'],['Coverage checked','Dry spots addressed','Overspray corrected','Heads aligned','Runoff reviewed','Drip inspected']],\n['Controller Programming','Build an appropriate irrigation schedule',['Station mapping','Start times','Run times','Watering days','Seasonal adjust','Cycle-and-soak','Sensors','Duplicate starts'],['Stations mapped','Start times reviewed','Run times entered','Water days entered','Drip/turf separated','Duplicate starts checked']],\n['Backfill &amp; Property Restoration','Cover only after tests pass',['Final inspection','Photograph buried components','Route documentation','Backfill','Compaction','Restoration'],['!Mainline tested before burial','!Laterals tested before burial','!Electrical operation confirmed before burial','Valve boxes accessible','Routes documented','Site restored']],\n['Master Troubleshooting Center','Use symptom-first hydraulic and electrical diagnosis',['Zone will not run','Zone will not shut off','Multiple zones','Low pressure','One head failure','Dry areas','Weak drip','Controller/no water'],['Know system shutoff','Know station map','Basic test tools available','Use evidence before replacing parts']],\n['Final Commissioning','Verify the finished system as one complete installation',['Supply inspection','Zone final test','Controller review','Coverage review','Valve access','System map'],['Water connection inspected','Backflow addressed','Mainline leak-free','Valves labeled','Every zone runs','Every zone shuts off','Coverage adjusted','Drip inspected','Controller programmed']],\n['System Documentation &amp; Maintenance','Create an as-built record and service baseline',['As-built map','Valve numbering','Station chart','Nozzle records','Drip records','Seasonal inspection','Filter cleaning','Head maintenance'],['As-built map created','Valve numbers recorded','Station chart saved','Nozzle/drip notes saved','Maintenance reviewed']],\n['Flagship Completion','Convert the course into a permanent field reference',['Review incomplete sections','Review flagged items','Verify project record','Save system reference','Switch to reference mode'],['Required sections reviewed','Project record complete','Final notes saved','System reference ready']]\n];\nconst sections=data.map((x,i)=&gt;({n:i+1,title:x[0],desc:x[1],lessons:x[2],checks:x[3]}));\nconst KEY='tradestack-premium-irrigation-v1';\nconst state=JSON.parse(localStorage.getItem(KEY)||'null')||{reviewed:{},checks:{},opened:{},last:1,project:{}};\nconst save=()=&gt;{localStorage.setItem(KEY,JSON.stringify(state));renderHeader()};\nconst done=s=&gt;state.reviewed[s.n]&amp;&amp;s.checks.every((_,i)=&gt;state.checks[s.n+'-'+i]);\nconst status=s=&gt;done(s)?['Complete','done']:state.opened[s.n]?['In Progress','prog']:['Not Started','new'];\nlet activePhase='overview',activeSection=1;\nfunction renderHeader(){let c=sections.filter(done).length,p=Math.round(c/24*100);overallText.textContent=`${c} of 24 sections complete`;pct.textContent=p+'%';fill.style.width=p+'%';document.getElementById('continueBtn').textContent=c?'Continue Flagship':'Start Flagship'}\nfunction renderPhases(){phases.innerHTML=window.phases?'' : '';document.getElementById('phases').innerHTML=phasesData()}\nfunction phasesData(){return phases.map(p=&gt;`&lt;button class=\&quot;phase ${p[0]===activePhase?'active':''}\&quot; data-phase=\&quot;${p[0]}\&quot;&gt;${p[1]}&lt;/button&gt;`).join('')}\nfunction phaseRender(){document.getElementById('phases').innerHTML=phasesData();document.querySelectorAll('[data-phase]').forEach(b=&gt;b.onclick=()=&gt;{activePhase=b.dataset.phase;phaseRender();renderList()});renderList()}\nfunction renderList(){let p=phases.find(x=&gt;x[0]===activePhase);phaseTitle.textContent=p[1];phaseText.textContent=p[2];sectionList.innerHTML=p[3].map(n=&gt;{let s=sections[n-1],st=status(s);return `&lt;button class=\&quot;card\&quot; data-open=\&quot;${n}\&quot;&gt;&lt;div class=\&quot;row\&quot;&gt;&lt;div class=\&quot;num\&quot;&gt;${n}&lt;/div&gt;&lt;div&gt;&lt;div class=\&quot;ctitle\&quot;&gt;${s.title}&lt;/div&gt;&lt;div class=\&quot;desc\&quot;&gt;${s.desc}&lt;/div&gt;&lt;/div&gt;&lt;div class=\&quot;state ${st[1]}\&quot;&gt;${st[0]}&lt;/div&gt;&lt;/div&gt;&lt;/button&gt;`}).join('');document.querySelectorAll('[data-open]').forEach(b=&gt;b.onclick=()=&gt;openSection(+b.dataset.open))}\nfunction openSection(n){activeSection=n;state.last=n;state.opened[n]=1;save();showScreen('section');renderSection()}\nfunction renderSection(){let s=sections[activeSection-1];sectionTitle.textContent=s.title;sectionSub.textContent=`Section ${s.n} of 24 • ${s.desc}`;learn.innerHTML=s.lessons.map((x,i)=&gt;`&lt;div class=\&quot;lesson\&quot;&gt;&lt;h3&gt;${i+1}. ${x}&lt;/h3&gt;&lt;p&gt;${lessonText(s.n,x)}&lt;/p&gt;${i===0?`&lt;div class=\&quot;note\&quot;&gt;&lt;strong&gt;FIELD NOTE&lt;/strong&gt;&lt;br&gt;${fieldNote(s.n)}&lt;/div&gt;`:''}&lt;/div&gt;`).join('')+`&lt;div class=\&quot;lesson\&quot;&gt;&lt;button class=\&quot;btn ${state.reviewed[s.n]?'secondary':'primary'}\&quot; id=\&quot;reviewBtn\&quot;&gt;${state.reviewed[s.n]?'✓ Learning Reviewed':'Mark Learning Reviewed ✓'}&lt;/button&gt;&lt;/div&gt;`;reviewBtn.onclick=()=&gt;{state.reviewed[s.n]=!state.reviewed[s.n];save();renderSection();renderList()};renderDiagram(s);renderCalc();renderChecks(s);trouble.innerHTML=`&lt;div class=\&quot;tree\&quot;&gt;&lt;h3&gt;Quick Diagnostic&lt;/h3&gt;&lt;p&gt;${quickRoute(s.n)}&lt;/p&gt;&lt;button class=\&quot;btn primary\&quot; onclick=\&quot;showScreen('troubleshoot')\&quot;&gt;Open Master Troubleshooting&lt;/button&gt;&lt;/div&gt;`}\n\nconst lessonDetail={\n7:{\n'Pipe type: PVC vs polyethylene':'PVC is common in many residential irrigation systems because it is rigid, widely available, and uses solvent-welded fittings. Polyethylene is flexible and commonly joined with insert/compression-style fittings approved for the pipe. Climate, soil, local practice, pressure rating, manufacturer requirements, and code determine the appropriate material.',\n'Pipe sizing: mainline and laterals':'Select pipe size from design flow and pressure-loss limits, not from habit. Common residential nominal sizes include 3/4 in, 1 in, and 1-1/4 in, but larger systems may require larger pipe. Confirm inside diameter, pressure rating, velocity, friction loss, run length, elevation, and manufacturer data before final sizing.',\n'90° and 45° elbows':'Elbows change direction. A 90° makes a sharp turn; a 45° makes a gentler change. Every fitting adds hydraulic resistance, so unnecessary bends consume pressure and complicate repairs.',\n'Tees and reducing tees':'A tee creates a branch. A reducing tee changes size at the branch or run. Use them where the hydraulic design calls for a branch, not merely where the trench happens to be convenient.',\n'Couplings and repair couplings':'Standard couplings join straight pipe during assembly. Repair/slip couplings are useful when an existing line cannot be flexed enough for a normal socket connection. Use a fitting specifically approved for the pipe material and repair condition.',\n'Reducers and threaded adapters':'Reducers transition between pipe sizes. Male/female threaded adapters transition from solvent-welded or other pipe connections to threaded components such as valves or serviceable assemblies. Avoid overtightening plastic threaded fittings.',\n'Unions, caps, plugs, risers and swing joints':'Unions can improve serviceability around equipment. Caps/plugs terminate or test lines. Risers and swing joints connect heads while allowing final grade/alignment adjustment and helping isolate stress from the lateral.',\n'Valve/manifold fittings':'Manifolds commonly require tees, adapters, unions or serviceable connections, and transitions to zone laterals. Leave clearance to remove a valve or solenoid later without rebuilding the entire manifold.',\n'Backflow/valves':'Select components with appropriate size, pressure rating, flow direction, and service access. Backflow type and installation requirements are controlled by the local authority having jurisdiction.',\n'Valve boxes and waterproof wire connectors':'Size boxes for actual service access. Use connectors rated for wet/direct-burial irrigation environments for field splices.',\n'Heads/nozzles':'Match body, nozzle, radius, arc, precipitation characteristics, and operating pressure to the zone design.',\n'Drip transition fittings':'Use compatible adapters to transition from the valve/filter/regulator assembly to drip tubing. Include tees, elbows, couplers, end flush fittings, stakes, and emitter connections required by the layout.',\n'Controller/sensors':'Match station count and sensor compatibility to the design, leaving reasonable expansion capacity where practical.',\n'Primer, cement and connection supplies':'For solvent-welded PVC, use products approved for the pipe/fitting material and follow the manufacturer cure and application instructions. Other pipe systems require their own approved connection method.'\n},\n\n1:{\n'How the complete system works':'Trace the hydraulic path from the water source through shutoff, backflow protection, mainline, valves, laterals, and finally the emission device. The electrical path is separate: controller → station conductor/common → solenoid → valve action.',\n'Mainline vs lateral lines':'The mainline is normally pressurized whenever the irrigation supply is open. Lateral piping is downstream of a zone valve and is pressurized only when that zone runs. That difference changes how leaks appear and how repairs are prioritized.',\n'Zones and hydrozones':'A zone groups devices with compatible flow, pressure, and watering needs. A hydrozone groups plants or turf with similar irrigation demand so programming can be efficient instead of watering everything like it has identical needs.',\n'Spray, rotor, bubbler, and drip':'Use emission devices according to area, plant type, spacing, and operating pressure. Avoid mixing unlike precipitation rates on one zone unless the design intentionally accounts for it.',\n'Valve/manifold fundamentals':'Each valve controls one zone. A grouped manifold simplifies service, but flow direction, accessibility, spacing, and future replacement clearance matter.',\n'Controller fundamentals':'The controller energizes one station output at a time in a basic system. The common conductor is shared by valve solenoids, so a common-wire fault can affect multiple stations.',\n'Backflow protection':'Backflow protection helps protect the potable water supply from reverse contamination. Required type, placement, testing, and permitting are jurisdiction-specific.',\n'Installation sequence':'Survey and test first, design second, mark and excavate third, install hydraulic and electrical components, flush and test, then backfill and document.'\n},\n3:{\n'Static pressure':'Static pressure is measured with no irrigation flow. Record it as a baseline, but do not use it alone to predict zone performance.',\n'Working pressure':'Working pressure is pressure while water is moving. It is usually lower than static pressure because friction and demand create losses.',\n'Available flow':'Available flow is the practical quantity of water that can be supplied while maintaining useful operating pressure. Build in reserve rather than designing at the absolute maximum.',\n'Bucket flow test':'Time how long it takes to fill a known volume, then calculate GPM. Repeat the test if the result seems inconsistent.',\n'Pressure gauge use':'Install the gauge at a point that represents the supply condition you are evaluating. Confirm fittings do not leak during the test.',\n'Design reserve':'Do not consume every last GPM in the design. Leave margin for pressure variation, minor fouling, and real-world conditions.'\n},\n6:{\n'Zone GPM':'Add the rated flow of all operating nozzles or emitters on the zone. Compare that total with the design flow available at useful pressure.',\n'Pipe diameter and velocity':'Pipe size affects friction loss and velocity. Undersized pipe can waste pressure and create poor performance even when the water source has enough total flow.',\n'Friction loss':'Pressure is lost as water moves through pipe and fittings. Use manufacturer or accepted hydraulic data for the actual pipe type and flow.',\n'Valve/fitting loss':'Valves, backflow devices, filters, regulators, and fittings each add loss. Hydraulic design should account for the whole path, not just pipe.',\n'Elevation effect':'Water gains or loses about 0.433 PSI for each vertical foot of elevation change. Uphill zones lose pressure; downhill areas gain it.',\n'Operating pressure':'The device at the hydraulically worst location still needs enough pressure to perform correctly after every expected loss.',\n'Oversized zones':'If calculated demand exceeds design capacity, split the zone or reduce nozzle demand. Installing it anyway is not a design strategy.'\n},\n12:{\n'Grouped vs individual valves':'Grouped manifolds simplify servicing and wiring. Individual valves may be useful where geography or system layout makes a central manifold impractical.',\n'Flow direction':'Install each valve in the manufacturer-marked direction of flow. Reversed valves can malfunction or fail to regulate correctly.',\n'Isolation':'Provide practical means to shut down irrigation service so repairs do not require unnecessary water shutdowns.',\n'Solenoid orientation':'Keep solenoids accessible and wire splices above standing water where possible within the valve box.',\n'Valve-box spacing':'Leave enough room to remove bonnets, solenoids, unions, or adapters later. A valve box should not be a puzzle box.',\n'Common mistakes':'Buried fittings outside the box, inaccessible valves, crossed zone connections, and cramped manifolds turn routine service into excavation.'\n},\n15:{\n'Dedicated drip zone':'Drip components often operate at different pressure and scheduling needs than spray or rotors, so a dedicated zone is usually preferred.',\n'Filtration':'Filters protect emitters and dripline from debris. Place them where they can actually be opened and serviced.',\n'Pressure regulation':'Many drip products require lower pressure than the upstream irrigation supply. Use appropriate regulation for the selected products.',\n'Main tubing':'Route tubing to reduce kinks, exposure damage, and unnecessary length. Use compatible fittings rather than improvised plumbing.',\n'Emitters/dripline':'Choose output and spacing to match plant/root-zone needs. Avoid assuming one emitter layout fits every plant type.',\n'Tree/shrub layouts':'Distribute water through the active root zone rather than concentrating it directly against the trunk or stem.',\n'Flush points':'Every drip zone needs a practical way to flush debris from the tubing.'\n},\n16:{\n'Controller placement':'Mount the controller where it is protected, accessible, and installed according to manufacturer requirements and applicable electrical rules.',\n'Zone terminals':'Each zone conductor lands on its assigned station terminal. Label both ends before the wire bundle becomes archaeological evidence.',\n'Common terminal':'The common conductor completes the solenoid circuits for multiple valves. A loose or broken common can disable several zones at once.',\n'Solenoids':'A solenoid converts the controller signal into valve actuation. Test wiring before condemning the valve body.',\n'Multi-conductor wire':'Use irrigation-rated cable appropriate for the installation environment and leave spare conductors when practical.',\n'Waterproof splices':'Field splices need connectors approved for wet or direct-burial conditions. Ordinary indoor wire nuts are not irrigation components.',\n'Master valve/pump concepts':'Some systems use a master valve or pump-start relay. These circuits require correct controller support and manufacturer-specific wiring.',\n'Labeling':'Label controller stations, valve boxes, and conductors. Future troubleshooting becomes dramatically faster.'\n},\n17:{\n'Initial pressurization':'Open the supply gradually and watch for abnormal leakage or movement. Rapid pressurization can make a minor installation problem much more exciting than necessary.',\n'Mainline inspection':'Inspect exposed mainline joints and fittings while the line is under pressure before burial.',\n'Manifold inspection':'Check valve bodies, adapters, unions, threaded joints, and solenoids for leakage.',\n'Lateral flushing':'Flush laterals before installing or finalizing nozzles so construction debris does not immediately clog the new system.',\n'Zone tests':'Run each zone individually and confirm every outlet/device receives water as intended.',\n'Valve closure':'After each test, confirm the valve shuts completely and downstream flow stops normally.'\n},\n18:{\n'Visual coverage':'Observe the full zone, not just the nearest heads. Look for dry wedges, blocked spray, tilted bodies, and excessive overlap.',\n'Catch-can concept':'Catch-can testing can reveal distribution differences that are difficult to judge visually and helps compare uniformity.',\n'Dry spots':'A dry spot may come from spacing, nozzle selection, obstruction, low pressure, or a damaged device. Diagnose the cause before increasing runtime.',\n'Overspray':'Correct arc and radius before accepting water on walls, sidewalks, or streets as unavoidable.',\n'Alignment':'Heads should sit at proper grade and vertical alignment for the selected equipment and surface.',\n'Pressure symptoms':'Misting often suggests excessive pressure; weak patterns and incomplete pop-up can suggest low pressure or excessive demand.',\n'Runoff':'Use cycle-and-soak or other appropriate scheduling strategies when soil infiltration is slower than application rate.'\n},\n20:{\n'Final inspection':'Inspect every underground component that will become difficult to access after burial.',\n'Photograph buried components':'Take useful reference photos with surrounding landmarks so future repairs can locate tees, sleeves, splices, and route changes.',\n'Route documentation':'Update the as-built map when the field installation differs from the original plan.',\n'Backfill':'Place soil carefully to avoid moving heads, crushing tubing, or damaging wire.',\n'Compaction':'Restore trenches appropriately while avoiding damage to piping and fittings.',\n'Restoration':'Return turf, gravel, mulch, and hardscape edges to a safe and presentable condition.'\n}\n};\nfunction lessonText(n,x){\n  if(lessonDetail[n] &amp;&amp; lessonDetail[n][x]) return lessonDetail[n][x];\n  return `Understand ${x.toLowerCase()} as part of the complete installation sequence. Use manufacturer data, local requirements, and actual field conditions where they control the work.`;\n}\nfunction fieldNote(n){let m={3:'Save GPM and pressure under My Project so later design work uses the same field measurements.',6:'Oversized zones do not improve through optimism. Reduce demand or split the zone.',9:'TradeStack guides workflow, but utility location and local excavation requirements still govern the job.',10:'Confirm local backflow requirements before buying or installing the assembly.',20:'Future-you will appreciate photos of buried tees, sleeves, wire routes, and unusual fittings.'};return m[n]||'Use the checklist as an installation aid, not as legal certification or inspection approval.'}\nfunction renderDiagram(s){\n  diagram.innerHTML=`&lt;div class=\&quot;diagram\&quot;&gt;\n    &lt;div class=\&quot;diagram-select\&quot;&gt;\n      &lt;button class=\&quot;diagram-choice active\&quot; data-diag=\&quot;installart\&quot;&gt;Full Install&lt;/button&gt;&lt;button class=\&quot;diagram-choice\&quot; data-diag=\&quot;overall\&quot;&gt;Interactive System&lt;/button&gt;\n      &lt;button class=\&quot;diagram-choice\&quot; data-diag=\&quot;manifold\&quot;&gt;Valve Manifold&lt;/button&gt;\n      &lt;button class=\&quot;diagram-choice\&quot; data-diag=\&quot;wiring\&quot;&gt;Controller Wiring&lt;/button&gt;\n      &lt;button class=\&quot;diagram-choice\&quot; data-diag=\&quot;sprinkler\&quot;&gt;Sprinkler Zone&lt;/button&gt;\n      &lt;button class=\&quot;diagram-choice\&quot; data-diag=\&quot;drip\&quot;&gt;Drip Zone&lt;/button&gt;\n    &lt;/div&gt;\n    &lt;div id=\&quot;diagramCanvas\&quot;&gt;&lt;/div&gt;\n    &lt;div class=\&quot;sheet\&quot; id=\&quot;sheet\&quot;&gt;&lt;/div&gt;\n    &lt;div class=\&quot;diagram-caption\&quot;&gt;Tap labeled components for field notes. Diagrams are conceptual and must be adapted to manufacturer instructions and local requirements.&lt;/div&gt;\n  &lt;/div&gt;`;\n  document.querySelectorAll('[data-diag]').forEach(b=&gt;b.onclick=()=&gt;{\n    document.querySelectorAll('[data-diag]').forEach(x=&gt;x.classList.remove('active'));\n    b.classList.add('active'); drawDiagram(b.dataset.diag);\n  });\n  drawDiagram('installart');\n}\nfunction drawDiagram(type){\n  const installart=`&lt;div&gt;&lt;img class=\&quot;full-install-art\&quot; src=\&quot;data:image/png;base64,\&quot; alt=\&quot;TradeStack complete irrigation system installation diagram\&quot;&gt;&lt;div class=\&quot;art-note\&quot;&gt;Complete-system visual reference: main water line → shutoff/backflow → irrigation mainline → valve manifold/controller → zones → drip and emitters. Use the Interactive System tab for tappable component notes.&lt;/div&gt;&lt;/div&gt;`;\n  const overall=`&lt;div class=\&quot;diagram-tools\&quot;&gt;&lt;button class=\&quot;toolbtn on\&quot; data-layer=\&quot;water\&quot;&gt;Water Flow&lt;/button&gt;&lt;button class=\&quot;toolbtn on\&quot; data-layer=\&quot;wire\&quot;&gt;Electrical&lt;/button&gt;&lt;button class=\&quot;toolbtn on\&quot; data-layer=\&quot;zones\&quot;&gt;Zones&lt;/button&gt;&lt;button class=\&quot;tool