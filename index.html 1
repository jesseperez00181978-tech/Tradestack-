      [/loose deck railing|loose stair tread/, "Failed structural connection, rot, loose blocking, damaged stringer/post, or inadequate fasteners.", "Structural blocking, rated connectors/fasteners, tread/railing material, or replacement framing.", "Drill/driver, socket set, pry bar, square, saw, PPE.", "High", "$10-$250+", "$$$", "Moderate"],
      [/rotted exterior wood/, "Chronic moisture from failed flashing, drainage, coating, roof edge, or ground contact.", "Exterior replacement wood, flashing, primer/sealant, corrosion-resistant fasteners.", "Moisture probe, saw, pry bar, drill/driver, PPE.", "Medium", "$20-$200+", "$$", "Moderate"],
      [/joist damaged or sagging|damaged wall stud|header or framing problem/, "Structural overload, rot, improper cuts, settlement, failed bearing, or damaged framing.", "Structural lumber, engineered repair components, rated connectors and fasteners after design.", "Level, framing square, temporary support equipment, saw, drill/driver, PPE.", "High", "$50-$500+", "$$$", "Advanced"]
    ]
  };

  for (const rule of rulesByTrade[tradeKey] || []) {
    const [pattern, c, p, t, s, range, tier, level, specialNote] = rule;
    if (pattern.test(problem)) {
      cause = c;
      parts = p;
      tools = t;
      safety = s;
      cost = range;
      costTier = tier;
      difficulty = level;
      if (specialNote) note = specialNote;
      break;
    }
  }

  return { cause, parts, tools, safety, note, picture: step.problem, cost, costTier, difficulty };
}

