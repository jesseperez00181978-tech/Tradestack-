function commonsPhotoUrl(fileName) {
  if (/^(?:https?:|data:|blob:)/i.test(fileName)) return fileName;
  return `https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(fileName)}?width=1200`;
}

function commonsSourceUrl(fileName) {
  if (/^(?:data:|blob:)/i.test(fileName)) return "#";
  if (/^https?:\/\//i.test(fileName)) return fileName;
  return `https://commons.wikimedia.org/wiki/File:${encodeURIComponent(fileName).replace(/%20/g, "_")}`;
}

function getPhotoEntry(guideKey) {
  const key = photoAssignments[guideKey];
  if (!key || !photoLibrary[key]) return null;
  return { key, ...photoLibrary[key] };
}

function uniquePhotoEntries() {
  const usedKeys = [...new Set(Object.values(photoAssignments))];
  return usedKeys.map(key => ({ key, ...photoLibrary[key] })).filter(entry => entry.file);
}


