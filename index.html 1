function closePhoto() {
  const modal = document.getElementById("photoModal");
  modal.hidden = true;
  document.body.style.overflow = "";
  document.getElementById("photoModalImage").removeAttribute("src");
}

async function resolveCachedPhoto(url) {
  if (!("caches" in window)) return url;
  try {
    const cache = await caches.open(PHOTO_CACHE_NAME);
    const cached = await cache.match(url);
    if (cached) {
      const blob = await cached.blob();
      return URL.createObjectURL(blob);
    }

    if (!navigator.onLine) return url;
    const response = await fetch(url, { mode: "cors", credentials: "omit" });
    if (!response.ok) return url;
    await cache.put(url, response.clone());
    const blob = await response.blob();
    return URL.createObjectURL(blob);
  } catch (error) {
    console.warn("Photo cache unavailable", error);
    return url;
  }
}

async function hydrateVisiblePhotos() {
  const images = [...document.querySelectorAll("img[data-photo-url]")];
  await Promise.allSettled(images.map(async image => {
    const resolved = await resolveCachedPhoto(image.dataset.photoUrl);
    if (resolved && image.isConnected) image.src = resolved;
  }));
  updatePhotoCacheStatus();
}

async function cacheAllPhotos() {
  const button = document.getElementById("cachePhotosButton");
  if (!("caches" in window)) {
    showToast("Offline photo storage is not supported in this browser");
    return;
  }
  if (!navigator.onLine) {
    showToast("Connect to the internet before saving photos");
    return;
  }

  button.disabled = true;
  button.textContent = "Saving Photos...";
  const entries = uniquePhotoEntries();
  let saved = 0;
  let failed = 0;
  const cache = await caches.open(PHOTO_CACHE_NAME);

  for (let index = 0; index < entries.length; index += 4) {
    const batch = entries.slice(index, index + 4);
    await Promise.all(batch.map(async entry => {
      const url = commonsPhotoUrl(entry.file);
      try {
        const existing = await cache.match(url);
        if (!existing) {
          const response = await fetch(url, { mode: "cors", credentials: "omit" });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          await cache.put(url, response.clone());
        }
        saved += 1;
      } catch (error) {
        failed += 1;
        console.warn(`Could not cache ${entry.file}`, error);
      }
      button.textContent = `Saving ${saved + failed}/${entries.length}`;
    }));
  }

  button.disabled = false;
  button.textContent = "Save Photos Offline";
  await updatePhotoCacheStatus();
  showToast(failed ? `${saved} photos saved - ${failed} used fallbacks` : `All ${saved} photos saved offline`);
  hydrateVisiblePhotos();
}

async function updatePhotoCacheStatus() {
  const status = document.getElementById("photoCacheStatus");
  const button = document.getElementById("cachePhotosButton");
  if (!status || !button) return;

  const total = uniquePhotoEntries().length;
  if (!("caches" in window)) {
    status.firstElementChild.textContent = "Real photos:";
    button.textContent = "Browser Cache Unavailable";
    button.disabled = true;
    return;
  }

  try {
    const cache = await caches.open(PHOTO_CACHE_NAME);
    let count = 0;
    for (const entry of uniquePhotoEntries()) {
      if (await cache.match(commonsPhotoUrl(entry.file))) count += 1;
    }
    status.firstElementChild.textContent = count === total
      ? `Offline photos: ${count}/${total} saved.`
      : `Real photos: ${count}/${total} saved offline.`;
  } catch (error) {
    console.warn("Could not read photo cache", error);
  }
}

function populatePhotoCredits() {
  const list = document.getElementById("photoCreditsList");
  list.innerHTML = uniquePhotoEntries().map(photo => `
    <p>
      <a href="${escapeHtml(commonsSourceUrl(photo.file))}" target="_blank" rel="noopener noreferrer">${escapeHtml(photo.title)}</a>
      - ${escapeHtml(photo.credit)} | ${escapeHtml(photo.license)}
    </p>`).join("");
}

function bindGuideActions() {
  document.querySelectorAll(".guide-card").forEach(card => {
    const id = card.dataset.guideId;
    const favoriteButton = card.querySelector('[data-action="favorite"]');
    const expandButton = card.querySelector('[data-action="expand"]');
    const copyButton = card.querySelector('[data-action="copy"]');
    const photoButton = card.querySelector(".photo-trigger");
    const body = card.querySelector(".guide-body");

    favoriteButton?.addEventListener("click", () => toggleFavorite(id));
    photoButton?.addEventListener("click", () => {
      const image = photoButton.querySelector("img");
      openPhoto(photoButton.dataset.photoKey, image?.src || "");
    });
    copyButton?.addEventListener("click", () => copyGuide(id));
    expandButton?.addEventListener("click", () => {
      const willOpen = body.hidden;
      body.hidden = !willOpen;
      expandButton.setAttribute("aria-expanded", String(willOpen));
      expandButton.textContent = willOpen ? "Close Guide" : "Open Guide";
      if (willOpen) addRecent(id);
    });
  });
}

function updateStats() {
  document.getElementById("totalStat").textContent = String(guideIndex.length);
  document.getElementById("favoriteStat").textContent = String(favorites.size);
  document.getElementById("recentStat").textContent = String(recent.length);
  document.getElementById("photoStat").textContent = String(guideIndex.filter(item => getPhotoEntry(item.id)).length);
}

function updateNetworkStatus() {
  const status = document.getElementById("networkStatus");
  const online = navigator.onLine;
  status.className = `status-chip ${online ? "online" : "offline"}`;
  status.innerHTML = online
    ? "<strong>Online:</strong> Search and saved data are ready."
    : "<strong>Offline:</strong> Embedded guides, favorites, and recent history still work.";
}

function showToast(message) {
  const toast = document.getElementById("toast");
  clearTimeout(toastTimer);
  toast.textContent = message;
  toast.classList.add("show");
  toastTimer = setTimeout(() => toast.classList.remove("show"), 1800);
}

function verifyGuideCounts() {
  Object.entries(guides).forEach(([trade, data]) => {
    if (data.steps.length !== 20) {
      console.error(`${trade} has ${data.steps.length} guides instead of 20.`);
    }
  });
  if (guideIndex.length !== 160) {
    console.error(`TradeStack has ${guideIndex.length} total guides instead of 160.`);
  }

  const usage = {};
  Object.entries(photoAssignments).forEach(([id, key]) => {
    if (!guideMap.has(id)) console.error(`Photo assignment points to missing guide: ${id}`);
    if (!key) return;
    if (!photoLibrary[key]) console.error(`Photo assignment uses missing photo key: ${key}`);
    usage[key] = (usage[key] || 0) + 1;
  });
  Object.entries(usage).forEach(([key, count]) => {
    if (count > 1) console.info(`Photo ${key} is intentionally reused for ${count} related guides.`);
  });
}

function initialize() {
  verifyGuideCounts();
  favorites = new Set([...favorites].filter(id => guideMap.has(id)));
  recent = recent.filter(id => guideMap.has(id));
  saveList(STORAGE.favorites, [...favorites]);
  saveList(STORAGE.recent, recent);
  updateStats();
  updateNetworkStatus();
  populatePhotoCredits();
  updatePhotoCacheStatus();

  document.getElementById("photoModalClose").addEventListener("click", closePhoto);
  document.getElementById("photoModal").addEventListener("click", event => {
    if (event.target.id === "photoModal") closePhoto();
  });

  document.querySelectorAll("[data-trade]").forEach(button => {
    button.addEventListener("click", () => showTrade(button.dataset.trade));
  });

  document.querySelectorAll("[data-view]").forEach(button => {
    button.addEventListener("click", () => setView(button.dataset.view));
  });

  document.getElementById("searchButton").addEventListener("click", runSearch);
  document.getElementById("clearButton").addEventListener("click", clearEverything);
  document.getElementById("closePanel").addEventListener("click", () => {
    document.getElementById("guidePanel").style.display = "none";
  });
  document.getElementById("topBtn").addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

  document.getElementById("difficultyFilter").addEventListener("change", event => {
    state.difficulty = event.target.value;
    renderCurrentView();
  });

  document.getElementById("costFilter").addEventListener("change", event => {
    state.cost = event.target.value;
    renderCurrentView();
  });

  const search = document.getElementById("search");
  search.addEventListener("keydown", event => {
    if (event.key === "Enter") {
      event.preventDefault();
      runSearch();
    }
    if (event.key === "Escape") {
      if (!document.getElementById("photoModal").hidden) closePhoto();
      else clearEverything();
    }
  });

  search.addEventListener("input", () => {
    clearTimeout(searchTimer);
    const query = search.value.trim();
    if (!query) {
      if (state.view === "search") {
        state.view = "all";
        state.query = "";
        document.getElementById("guidePanel").style.display = "none";
        updateActiveViewButtons();
      }
      return;
    }
