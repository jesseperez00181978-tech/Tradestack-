\&quot;${x}\&quot;&gt;${x}&lt;/button&gt;`).join('');document.querySelectorAll('[data-sym]').forEach(b=&gt;b.onclick=()=&gt;startTree(b.dataset.sym))}\nlet root='',node=null,path=[];\nfunction startTree(n){root=n;node=trees[n];path=[n];renderTree()}\nfunction renderTree(){if(!node){tree.innerHTML='';return}if(node.r){tree.innerHTML=`&lt;div class=\&quot;tree\&quot;&gt;&lt;div class=\&quot;crumb\&quot;&gt;${path.join(' › ')}&lt;/div&gt;&lt;div class=\&quot;resultbox\&quot;&gt;&lt;h3&gt;${node.r}&lt;/h3&gt;&lt;p&gt;${node.w}&lt;/p&gt;&lt;button class=\&quot;btn primary\&quot; onclick=\&quot;startTree(root)\&quot;&gt;Start Over&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;`;return}tree.innerHTML=`&lt;div class=\&quot;tree\&quot;&gt;&lt;div class=\&quot;crumb\&quot;&gt;${path.join(' › ')}&lt;/div&gt;&lt;div class=\&quot;question\&quot;&gt;${node.q}&lt;/div&gt;&lt;div class=\&quot;choices\&quot;&gt;&lt;button class=\&quot;choice\&quot; data-a=\&quot;y\&quot;&gt;YES&lt;/button&gt;&lt;button class=\&quot;choice\&quot; data-a=\&quot;n\&quot;&gt;NO / NOT SURE&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;`;document.querySelectorAll('[data-a]').forEach(b=&gt;b.onclick=()=&gt;{path.push(b.dataset.a==='y'?'Yes':'No / Not sure');node=node[b.dataset.a];renderTree()})}\n\nconst commissionItems=[\n['Supply &amp; Mainline','Mainline pressurizes without visible leakage and shutoff works.'],\n['Backflow / Protection','Installed arrangement is addressed according to local requirements and remains serviceable.'],\n['Valve Manifold','Valves are dry, accessible, labeled, and each operates independently.'],\n['Sprinkler Zones','Heads rise, rotate/spray correctly, and zones shut off normally.'],\n['Drip Zones','Filter/regulator/tubing/emission points operate and the zone flushes correctly.'],\n['Controller &amp; Wiring','Stations map correctly, common is reliable, and field splices are secure.'],\n['Coverage &amp; Runoff','Coverage is adjusted and runoff/overspray are addressed.'],\n['As-Built Record','Valve locations, station mapping, and important buried routes are documented.']\n];\nstate.commission=state.commission||{};\nfunction renderCommission(){\n commissionGrid.innerHTML=commissionItems.map((x,i)=&gt;{let st=state.commission[i]||'';return `&lt;div class=\&quot;commission-row ${st}\&quot;&gt;&lt;div&gt;&lt;strong&gt;${i+1}. ${x[0]}&lt;/strong&gt;&lt;div class=\&quot;muted\&quot;&gt;${x[1]}&lt;/div&gt;&lt;/div&gt;&lt;div class=\&quot;commission-actions\&quot;&gt;&lt;button class=\&quot;passbtn\&quot; data-cpass=\&quot;${i}\&quot;&gt;PASS&lt;/button&gt;&lt;button class=\&quot;issuebtn\&quot; data-cissue=\&quot;${i}\&quot;&gt;ISSUE&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;`}).join('');\n document.querySelectorAll('[data-cpass]').forEach(b=&gt;b.onclick=()=&gt;{state.commission[b.dataset.cpass]='pass';save();renderCommission()});\n document.querySelectorAll('[data-cissue]').forEach(b=&gt;b.onclick=()=&gt;{state.commission[b.dataset.cissue]='issue';save();renderCommission()});\n let vals=commissionItems.map((_,i)=&gt;state.commission[i]||'');\n let pass=vals.filter(x=&gt;x==='pass').length, issue=vals.filter(x=&gt;x==='issue').length;\n commissionSummary.innerHTML=`&lt;div class=\&quot;kpi\&quot;&gt;${pass}/8 Passed&lt;/div&gt;&lt;div class=\&quot;muted\&quot;&gt;${issue} issue(s) flagged • ${8-pass-issue} not tested&lt;/div&gt;${pass===8?'&lt;div class=\&quot;note\&quot;&gt;&lt;strong&gt;🏆 COMMISSIONING COMPLETE&lt;/strong&gt;&lt;br&gt;All eight commissioning groups are marked passed. Keep the as-built record for future service.&lt;/div&gt;':issue?'&lt;div class=\&quot;note warning\&quot;&gt;&lt;strong&gt;ISSUES REMAIN&lt;/strong&gt;&lt;br&gt;Resolve flagged items, retest, and update the result before calling the installation finished.&lt;/div&gt;':''}`;\n}\nfunction renderProgress(){let d=sections.filter(done),p=sections.filter(s=&gt;state.opened[s.n]&amp;&amp;!done(s));progress.innerHTML=`&lt;div class=\&quot;lesson\&quot;&gt;&lt;h3&gt;${d.length}/24 complete&lt;/h3&gt;&lt;p&gt;${p.length} section(s) in progress.&lt;/p&gt;&lt;div class=\&quot;note\&quot;&gt;&lt;strong&gt;COMMISSIONING READINESS&lt;/strong&gt;&lt;br&gt;${d.length===24?'🏆 Full-system guide complete. Field-reference mode ready.':(d.length&gt;=20?'Final checks remain before completion.':'Continue the guided build. Critical field checks remain visible in their sections.')}&lt;/div&gt;&lt;/div&gt;`+sections.map(s=&gt;{let st=status(s);return `&lt;div class=\&quot;card\&quot;&gt;&lt;strong&gt;${s.n}. ${s.title}&lt;/strong&gt;&lt;div class=\&quot;state ${st[1]}\&quot; style=\&quot;margin-top:5px\&quot;&gt;${st[0]}&lt;/div&gt;&lt;/div&gt;`}).join('')}\nfunction showScreen(n){document.querySelectorAll('.screen').forEach(s=&gt;s.classList.remove('show'));document.getElementById('screen-'+n).classList.add('show');document.querySelectorAll('.nav').forEach(b=&gt;b.classList.toggle('active',b.dataset.screen===n));if(n==='project')renderProject();if(n==='commission')renderCommission();if(n==='progress')renderProgress();if(n==='module')phaseRender();window.scrollTo({top:0,behavior:'smooth'})}\nfunction esc(s){return String(s).replace(/[&amp;&lt;&gt;\&quot;]/g,m=&gt;({'&amp;':'&amp;amp;','&lt;':'&amp;lt;','&gt;':'&amp;gt;','\&quot;':'&amp;quot;'}[m]))}\ndocument.querySelectorAll('.tab').forEach(b=&gt;b.onclick=()=&gt;{document.querySelectorAll('.tab').forEach(x=&gt;x.classList.remove('active'));b.classList.add('active');document.querySelectorAll('.pane').forEach(x=&gt;x.classList.remove('show'));document.getElementById(b.dataset.tab).classList.add('show')});\ndocument.querySelectorAll('.nav[data-screen]').forEach(b=&gt;b.onclick=()=&gt;showScreen(b.dataset.screen));\ndocument.getElementById('continueBtn').onclick=()=&gt;openSection(state.last||1);\nrenderHeader();phaseRender();renderProject();renderSymptoms();renderCommission();\n&lt;\/script&gt;\n&lt;/body&gt;\n&lt;/html&gt;&quot;},{&quot;emoji&quot;:&quot;❄️&quot;,&quot;title&quot;:&quot;Complete HVAC Split-System Retrofit &amp; Installation — Flagship&quot;,&quot;file&quot;:&quot;tradestack-premium-hvac-retrofit-flagship-v1.html&quot;,&quot;html&quot;:&quot;&lt;!doctype html&gt;&lt;html lang=\&quot;en\&quot;&gt;&lt;head&gt;&lt;meta charset=\&quot;utf-8\&quot;&gt;&lt;meta name=\&quot;viewport\&quot; content=\&quot;width=device-width,initial-scale=1\&quot;&gt;&lt;title&gt;TradeStack Premium • Complete HVAC Split-System Retrofit &amp; Installation&lt;/title&gt;&lt;style&gt;:root{--bg:#07090d;--p:#111722;--l:#2b3b52;--t:#f4f8ff;--m:#aab8ca;--c:#66d9ff;--g:#ffbf69}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--t);font-family:system-ui,-apple-system,Segoe UI,sans-serif}header{padding:24px 18px;background:linear-gradient(145deg,#0c1625,#101522);border-bottom:1px solid var(--l)}.badge{color:var(--g);font-weight:900;font-size:12px;letter-spacing:1.5px}h1{font-size:clamp(26px,7vw,46px);margin:8px 0}header p,p{color:var(--m);line-height:1.55}.warn{margin-top:14px;padding:13px;border:1px solid #6f5121;border-radius:12px;background:#21190d;color:#ffe4b0}nav{display:flex;gap:8px;overflow:auto;padding:12px;position:sticky;top:0;background:#080c12;border-bottom:1px solid var(--l);z-index:3}nav button{white-space:nowrap;border:1px solid #334861;background:#121c2b;color:#eaf5ff;border-radius:999px;padding:9px 12px}main{max-width:920px;margin:auto;padding:14px}section{background:var(--p);border:1px solid var(--l);border-radius:16px;padding:18px;margin:12px 0}.k{font-size:11px;letter-spacing:1.5px;color:var(--c);font-weight:900}h2{margin:5px 0 8px;font-size:22px}.checks{display:grid;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid #26364c}label{color:#d9e6f5;font-size:14px}.diagram{padding:16px;border:1px solid #36516d;border-radius:14px;background:#0b1320;margin:14px 0;overflow:auto}.flow{font-family:monospace;white-space:pre;line-height:1.7;color:#d9f5ff}footer{padding:24px 18px 80px;color:var(--m);text-align:center}button.top{position:fixed;right:14px;bottom:14px;border:0;border-radius:999px;padding:12px 15px;background:#1d7ea5;color:white;font-weight:900}&lt;/style&gt;&lt;/head&gt;&lt;body&gt;&lt;header&gt;&lt;div class=\&quot;badge\&quot;&gt;TRADESTACK PREMIUM • FLAGSHIP INSTALLATION&lt;/div&gt;&lt;h1&gt;❄️ Complete HVAC Split-System Retrofit &amp; Installation&lt;/h1&gt;&lt;p&gt;Field Assist for a full split-system retrofit: removal, evaporator coil, condenser, line set, nitrogen-purged brazing, electrical and control wiring, thermostat/control board, pressure testing, evacuation, charging, airflow, startup and commissioning.&lt;/p&gt;&lt;div class=\&quot;warn\&quot;&gt;&lt;b&gt;Qualified-work boundary:&lt;/b&gt; Refrigerant handling requires Section 608 certification where applicable. Electrical, fuel-gas, combustion, structural and code-regulated work must follow applicable law, permits, manufacturer instructions and qualified-trade requirements. Equipment-specific nameplate/manual values always control.&lt;/div&gt;&lt;/header&gt;&lt;nav&gt;&lt;button onclick=\&quot;go(1)\&quot;&gt;1. Project Scope &amp; Retrofit Assessment&lt;/button&gt;&lt;button onclick=\&quot;go(2)\&quot;&gt;2. Load, Match &amp; Compatibility Check&lt;/button&gt;&lt;button onclick=\&quot;go(3)\&quot;&gt;3. Safety, PPE &amp; Work-Zone Setup&lt;/button&gt;&lt;button onclick=\&quot;go(4)\&quot;&gt;4. Recover Existing Refrigerant&lt;/button&gt;&lt;button onclick=\&quot;go(5)\&quot;&gt;5. Disconnect &amp; Remove Existing Equipment&lt;/button&gt;&lt;button onclick=\&quot;go(6)\&quot;&gt;6. Prepare Indoor Cabinet / Furnace / Air Handler&lt;/button&gt;&lt;button onclick=\&quot;go(7)\&quot;&gt;7. Set &amp; Seal Evaporator Coil&lt;/button&gt;&lt;button onclick=\&quot;go(8)\&quot;&gt;8. Set Outdoor Condensing Unit&lt;/button&gt;&lt;button onclick=\&quot;go(9)\&quot;&gt;9. Evaluate or Replace Line Set&lt;/button&gt;&lt;button onclick=\&quot;go(10)\&quot;&gt;10. Route Suction &amp; Liquid Lines&lt;/button&gt;&lt;button onclick=\&quot;go(11)\&quot;&gt;11. Nitrogen-Purged Brazing&lt;/button&gt;&lt;button onclick=\&quot;go(12)\&quot;&gt;12. Condensate Drain &amp; Overflow Protection&lt;/button&gt;&lt;button onclick=\&quot;go(13)\&quot;&gt;13. Line-Voltage Electrical&lt;/button&gt;&lt;button onclick=\&quot;go(14)\&quot;&gt;14. Outdoor Control Wiring&lt;/button&gt;&lt;button onclick=\&quot;go(15)\&quot;&gt;15. Indoor Control Board Wiring&lt;/button&gt;&lt;button onclick=\&quot;go(16)\&quot;&gt;16. Thermostat Cable &amp; Thermostat Setup&lt;/button&gt;&lt;button onclick=\&quot;go(17)\&quot;&gt;17. Control-Circuit Continuity Check&lt;/button&gt;&lt;button onclick=\&quot;go(18)\&quot;&gt;18. Pressure Test &amp; Leak Check&lt;/button&gt;&lt;button onclick=\&quot;go(19)\&quot;&gt;19. Evacuation &amp; Dehydration&lt;/button&gt;&lt;button onclick=\&quot;go(20)\&quot;&gt;20. Release / Weigh / Adjust Refrigerant Charge&lt;/button&gt;&lt;button onclick=\&quot;go(21)\&quot;&gt;21. Airflow &amp; Static-Pressure Setup&lt;/button&gt;&lt;button onclick=\&quot;go(22)\&quot;&gt;22. Startup Sequence&lt;/button&gt;&lt;button onclick=\&quot;go(23)\&quot;&gt;23. Commissioning Measurements&lt;/button&gt;&lt;button onclick=\&quot;go(24)\&quot;&gt;24. Performance &amp; Comfort Verification&lt;/button&gt;&lt;button onclick=\&quot;go(25)\&quot;&gt;25. Final Documentation &amp; Handoff&lt;/button&gt;&lt;/nav&gt;&lt;main&gt;&lt;div class=\&quot;diagram\&quot;&gt;&lt;b&gt;Typical control-path reference&lt;/b&gt;&lt;div class=\&quot;flow\&quot;&gt;THERMOSTAT\n R ───────────────► Indoor control R\n C ◄──────────────► Indoor control C\n Y/Y1 ────────────► Cooling call ─────► Outdoor contactor/control\n G ───────────────► Indoor blower call\n W/W1 / W2 ───────► Heat stages where applicable\n O/B ─────────────► Heat-pump reversing valve where applicable\n\nAlways follow the actual equipment wiring diagram.&lt;/div&gt;&lt;/div&gt;&lt;section id=\&quot;s1\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 01&lt;/div&gt;&lt;h2&gt;Project Scope &amp; Retrofit Assessment&lt;/h2&gt;&lt;p&gt;Confirm system type, existing conditions, access, documentation, permits, and the exact manufacturer installation instructions before removal.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-1-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-1-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-1-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s2\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 02&lt;/div&gt;&lt;h2&gt;Load, Match &amp; Compatibility Check&lt;/h2&gt;&lt;p&gt;Verify equipment pairing, capacity/design basis, AHRI/manufacturer match where applicable, voltage/phase, metering device, blower capability, line-set limits, and approved accessories.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-2-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-2-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-2-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s3\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 03&lt;/div&gt;&lt;h2&gt;Safety, PPE &amp; Work-Zone Setup&lt;/h2&gt;&lt;p&gt;Establish electrical lockout/tagout, refrigerant handling controls, hot-work protection, ventilation, fire watch, ladder/lifting safety, and protection of occupied areas.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-3-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-3-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-3-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s4\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 04&lt;/div&gt;&lt;h2&gt;Recover Existing Refrigerant&lt;/h2&gt;&lt;p&gt;Identify refrigerant, connect approved recovery equipment, recover without intentional venting, document recovered refrigerant, and handle cylinders correctly. Section 608 requirements apply.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-4-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-4-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-4-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s5\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 05&lt;/div&gt;&lt;h2&gt;Disconnect &amp; Remove Existing Equipment&lt;/h2&gt;&lt;p&gt;Isolate power and controls, disconnect refrigerant piping and drains safely, protect openings, remove condenser/coil without damaging reusable infrastructure, and inspect the work area.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-5-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-5-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-5-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s6\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 06&lt;/div&gt;&lt;h2&gt;Prepare Indoor Cabinet / Furnace / Air Handler&lt;/h2&gt;&lt;p&gt;Inspect cabinet, blower, heat exchanger area where applicable, filter arrangement, transitions, plenums, access, airflow direction, and coil fit before setting the new coil.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-6-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-6-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-6-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s7\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 07&lt;/div&gt;&lt;h2&gt;Set &amp; Seal Evaporator Coil&lt;/h2&gt;&lt;p&gt;Orient and level the coil per manufacturer requirements, maintain service access, seal cabinet/plenum connections, protect insulation, and confirm metering-device requirements.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-7-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-7-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-7-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s8\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 08&lt;/div&gt;&lt;h2&gt;Set Outdoor Condensing Unit&lt;/h2&gt;&lt;p&gt;Provide a stable level base, required clearances, service access, drainage/snow considerations, vibration control where needed, and protect the coil from construction damage.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-8-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-8-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-8-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s9\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 09&lt;/div&gt;&lt;h2&gt;Evaluate or Replace Line Set&lt;/h2&gt;&lt;p&gt;Confirm tubing diameter, length, elevation, cleanliness, oil/refrigerant compatibility, routing, support, insulation, and manufacturer limits. Replace contaminated or unsuitable piping.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-9-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-9-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-9-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s10\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 10&lt;/div&gt;&lt;h2&gt;Route Suction &amp; Liquid Lines&lt;/h2&gt;&lt;p&gt;Make clean bends, prevent kinks, support tubing, protect penetrations, maintain insulation continuity, avoid rub points, and leave serviceable connections at both units.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-10-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-10-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-10-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s11\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 11&lt;/div&gt;&lt;h2&gt;Nitrogen-Purged Brazing&lt;/h2&gt;&lt;p&gt;Flow dry nitrogen while brazing to limit internal oxidation. Protect valves and nearby components from heat, use appropriate brazing materials, and follow equipment-specific procedures.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-11-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-11-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-11-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s12\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 12&lt;/div&gt;&lt;h2&gt;Condensate Drain &amp; Overflow Protection&lt;/h2&gt;&lt;p&gt;Install trapped/vented drainage when required by equipment/application, maintain slope, provide secondary protection where required, support piping, and prove drainage with water.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-12-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-12-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-12-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s13\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 13&lt;/div&gt;&lt;h2&gt;Line-Voltage Electrical&lt;/h2&gt;&lt;p&gt;Verify disconnect, overcurrent protection, conductor sizing, grounding/bonding, voltage and phase against nameplate and applicable code. Never substitute generic values for equipment requirements.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-13-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-13-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-13-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s14\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 14&lt;/div&gt;&lt;h2&gt;Outdoor Control Wiring&lt;/h2&gt;&lt;p&gt;Route and protect low-voltage conductors, land call/common conductors on the correct terminals, preserve polarity where applicable, and verify connections against the unit wiring diagram.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-14-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-14-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-14-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s15\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 15&lt;/div&gt;&lt;h2&gt;Indoor Control Board Wiring&lt;/h2&gt;&lt;p&gt;Identify R, C, Y/Y1, Y2, G, W/W1, W2, O/B and accessory terminals as applicable. Wire only according to the actual furnace/air-handler and accessory diagrams.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-15-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-15-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-15-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s16\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 16&lt;/div&gt;&lt;h2&gt;Thermostat Cable &amp; Thermostat Setup&lt;/h2&gt;&lt;p&gt;Route suitable thermostat cable, label conductors, avoid high-voltage interference, land terminals correctly, configure equipment type/staging, and document any unused conductors.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-16-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-16-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-16-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s17\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 17&lt;/div&gt;&lt;h2&gt;Control-Circuit Continuity Check&lt;/h2&gt;&lt;p&gt;Before energizing, inspect splices and terminations, check for shorts/miswires as appropriate, confirm transformer/control fuse condition, and compare the circuit to the wiring diagram.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-17-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-17-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-17-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s18\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 18&lt;/div&gt;&lt;h2&gt;Pressure Test &amp; Leak Check&lt;/h2&gt;&lt;p&gt;Use dry nitrogen and approved leak-detection methods. Follow the manufacturer’s maximum test pressure and component limitations; do not invent a universal pressure.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-18-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-18-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-18-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s19\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 19&lt;/div&gt;&lt;h2&gt;Evacuation &amp; Dehydration&lt;/h2&gt;&lt;p&gt;Use proper vacuum equipment, core tools where appropriate, clean hoses, and a micron gauge positioned to measure system vacuum. Evacuate and perform a standing/decay test to manufacturer/accepted practice.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-19-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-19-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-19-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s20\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 20&lt;/div&gt;&lt;h2&gt;Release / Weigh / Adjust Refrigerant Charge&lt;/h2&gt;&lt;p&gt;Use the equipment-prescribed charging method and factory data. Account for line length and accessories where specified. Use weight, subcooling, superheat, or other method only as applicable to that system.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-20-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-20-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-20-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s21\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 21&lt;/div&gt;&lt;h2&gt;Airflow &amp; Static-Pressure Setup&lt;/h2&gt;&lt;p&gt;Confirm filter and blower configuration, registers/dampers, blower speed/airflow settings, and measure total external static pressure when appropriate. Compare results with equipment data.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-21-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-21-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-21-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s22\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 22&lt;/div&gt;&lt;h2&gt;Startup Sequence&lt;/h2&gt;&lt;p&gt;Energize safely, call for operation, verify indoor blower and outdoor unit sequence, listen for abnormal operation, confirm condensate flow, and watch for immediate faults.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-22-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-22-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-22-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s23\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 23&lt;/div&gt;&lt;h2&gt;Commissioning Measurements&lt;/h2&gt;&lt;p&gt;Record voltage, amperage where appropriate, temperatures, airflow/static data, refrigerant-side measurements, thermostat operation, and other manufacturer-required commissioning values.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-23-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-23-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-23-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s24\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 24&lt;/div&gt;&lt;h2&gt;Performance &amp; Comfort Verification&lt;/h2&gt;&lt;p&gt;Confirm stable operation through required modes/stages, supply/return performance, thermostat response, drainage, vibration/noise, and that the original retrofit objective has been met.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-24-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-24-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-24-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;section id=\&quot;s25\&quot;&gt;&lt;div class=\&quot;k\&quot;&gt;SECTION 25&lt;/div&gt;&lt;h2&gt;Final Documentation &amp; Handoff&lt;/h2&gt;&lt;p&gt;Save model/serial numbers, equipment match data, readings, refrigerant/recovery notes, wiring changes, photos, startup results, warranty information, filter information, and service recommendations in Equipment History.&lt;/p&gt;&lt;div class=\&quot;checks\&quot;&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-25-1\&quot;&gt; Work checked against equipment documentation&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-25-2\&quot;&gt; Field condition verified before continuing&lt;/label&gt;&lt;label&gt;&lt;input type=\&quot;checkbox\&quot; data-k=\&quot;hvac-25-3\&quot;&gt; Section documented / ready for next step&lt;/label&gt;&lt;/div&gt;&lt;/section&gt;&lt;/main&gt;&lt;footer&gt;TradeStack field reference. Manufacturer instructions, equipment labels, approved plans, applicable codes and qualified-trade requirements control the actual installation.&lt;/footer&gt;&lt;button class=\&quot;top\&quot; onclick=\&quot;scrollTo(0,0)\&quot;&gt;↑ TOP&lt;/button&gt;&lt;script&gt;function go(n){document.getElementById(&#x27;s&#x27;+n).scrollIntoView({behavior:&#x27;smooth&#x27;})}document.querySelectorAll(&#x27;input[data-k]&#x27;).forEach(x=&gt;{x.checked=localStorage.getItem(x.dataset.k)===&#x27;1&#x27;;x.onchange=()=&gt;localStorage.setItem(x.dataset.k,x.checked?&#x27;1&#x27;:&#x27;0&#x27;)});&lt;\/script&gt;&lt;/body&gt;&lt;/html&gt;&quot;}]&lt;/script&gt;
