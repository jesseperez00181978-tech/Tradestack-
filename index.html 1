function renderCurrentView({ scroll = true } = {}) {
  const panel = document.getElementById("guidePanel");
  const title = document.getElementById("guideTitle");
  const count = document.getElementById("guideCount");
  const steps = document.getElementById("guideSteps");
  const results = getCurrentResults();

  title.textContent = viewTitle();
  count.textContent = `${results.length} guide${results.length === 1 ? "" : "s"}${activeFilterText()}`;

  if (!results.length) {
    steps.innerHTML = `
      <div class="no-results">
        No guides match this view. Try clearing a cost or difficulty filter, using a broader search term, or saving a favorite first.
      </div>`;
  } else {
    steps.innerHTML = results.map(result => renderGuideCard(result)).join("");
  }

  panel.style.display = "block";
  updateActiveViewButtons();
  bindGuideActions();
  hydrateVisiblePhotos();
  if (scroll) panel.scrollIntoView({ behavior: "smooth", block: "start" });
}

function updateActiveViewButtons() {
  document.querySelectorAll("[data-view]").forEach(button => {
    button.classList.toggle("active", button.dataset.view === state.view || (button.dataset.view === "all" && state.view === "trade"));
  });
}

function showTrade(tradeKey) {
  if (!guides[tradeKey]) return;
  state.view = "trade";
  state.trade = tradeKey;
  state.query = "";
  document.getElementById("search").value = "";
  renderCurrentView();
}

function runSearch() {
  const input = document.getElementById("search");
  const query = input.value.trim();
  if (!query) {
    state.view = "all";
    state.trade = null;
    state.query = "";
    renderCurrentView();
    return;
  }
  state.view = "search";
  state.trade = null;
  state.query = query;
  renderCurrentView();
}

function setView(view) {
  state.view = view;
  state.trade = null;
  if (view !== "search") state.query = "";
  if (view !== "search") document.getElementById("search").value = "";
  renderCurrentView();
}

function clearEverything() {
  state.view = "all";
  state.trade = null;
  state.query = "";
  state.difficulty = "all";
  state.cost = "all";
  document.getElementById("search").value = "";
  document.getElementById("difficultyFilter").value = "all";
  document.getElementById("costFilter").value = "all";
  document.getElementById("guidePanel").style.display = "none";
  updateActiveViewButtons();
  document.getElementById("search").focus();
}

function toggleFavorite(id) {
  if (favorites.has(id)) {
    favorites.delete(id);
    showToast("Removed from favorites");
  } else {
    favorites.add(id);
    showToast("Saved to favorites");
  }
  saveList(STORAGE.favorites, [...favorites]);
  updateStats();

  if (state.view === "favorites") {
    renderCurrentView({ scroll: false });
  } else {
    const card = [...document.querySelectorAll(".guide-card")].find(item => item.dataset.guideId === id);
    const button = card?.querySelector('[data-action="favorite"]');
    if (button) {
      const saved = favorites.has(id);
      button.classList.toggle("saved", saved);
      button.setAttribute("aria-pressed", String(saved));
      button.textContent = saved ? "\u2605" : "\u2606";
    }
  }
}

function addRecent(id) {
  recent = [id, ...recent.filter(item => item !== id)].slice(0, 12);
  saveList(STORAGE.recent, recent);
  updateStats();
}

function guideCopyText(result) {
  const d = result.details;
  const photo = getPhotoEntry(result.id);
  const photoLine = photo ? `\nPhoto source: ${commonsSourceUrl(photo.file)}` : "";
  return `${result.tradeTitle} - ${result.step.problem}\n\nSymptom: ${result.step.symptom}\nRepair steps: ${result.step.fix}\nMost likely cause: ${d.cause}\nParts: ${d.parts}\nTools: ${d.tools}\nDifficulty: ${d.difficulty}\nTypical DIY cost: ${d.cost}\nSafety: ${d.safety}\nField note: ${d.note}${photoLine}`;
}

async function copyGuide(id) {
  const result = guideMap.get(id);
  if (!result) return;
  const text = guideCopyText(result);
  try {
    await navigator.clipboard.writeText(text);
    showToast("Guide copied");
  } catch (error) {
    const textarea = document.createElement("textarea");
    textarea.value = text;
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand("copy");
    textarea.remove();
    showToast("Guide copied");
  }
}

function openPhoto(photoKey, currentImageUrl = "") {
  const photo = photoLibrary[photoKey];
