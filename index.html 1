          </div>
          <p class="guide-symptom"><b>Symptom:</b> ${escapeHtml(step.symptom)}</p>
          <div class="badge-row">
            <span class="badge ${difficultyClass}">Difficulty: ${escapeHtml(details.difficulty)}</span>
            <span class="badge cost-badge">DIY cost: ${escapeHtml(details.costTier)} - ${escapeHtml(details.cost)}</span>
