  function clear(){try{localStorage.removeItem(CHAT_HTML_KEY);localStorage.removeItem(CHAT_HISTORY_KEY);sessionStorage.removeItem(TOKEN_KEY)}catch{}history=[];body.innerHTML='';welcome();wireButtons();updateStatus()}
  function configure(opts={}){if(opts.baseUrl){try{localStorage.setItem(BASE_KEY,String(opts.baseUrl).replace(/\/+$/,''))}catch{}}if(opts.premiumToken)storeToken(String(opts.premiumToken));updateStatus();return {baseUrl:baseUrl(),aiEndpoint:aiEndpoint(),entitlementEndpoint:entitlementEndpoint(),premium:premiumActive()}}

  fab.onclick=()=>panel.classList.contains('open')?close():open();
  $('tsAiClose').onclick=close;$('tsAiClear').onclick=clear;send.onclick=()=>ask(input.value);
  input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();ask(input.value)}});
  input.addEventListener('input',()=>{input.style.height='46px';input.style.height=Math.min(input.scrollHeight,110)+'px'});
  $('tsAiQuick').querySelectorAll('button').forEach(b=>b.onclick=()=>ask(b.textContent));
  window.addEventListener('storage',e=>{if(e.key==='tradestackPremiumActive'||e.key===BASE_KEY)updateStatus()});

  if(!restoreHtml())welcome(); wireButtons(); updateStatus();
  window.TradeStackAI={open,close,ask,rankGuides:rank,configure,version:VERSION,endpoints:()=>({ai:aiEndpoint(),entitlement:entitlementEndpoint()})};
})();

</script>
</body>
</html>
