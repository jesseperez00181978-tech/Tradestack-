<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#2979ff" />
<title>TradeStack v1.11 • AI Assistant</title>
<link rel="manifest" href="manifest.json">
  <style>
  :root {
    --bg: #0d151d;
    --surface: #182430;
    --surface-2: #223140;
    --surface-3: #2b3a47;
    --border: #34485a;
    --text: #f5f7f9;
    --muted: #b8c8d4;
    --orange: #9e1b32;
    --orange-2: #5e0b18;
    --crimson-glow: #d7263d;
    --gold: #ffbf69;
    --green: #55c98a;
    --yellow: #ffd166;
    --red: #ff5a5f;
    --blue: #66b3ff;
    --shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
    --crimson-shadow: 0 0 14px rgba(215, 38, 61, 0.34);
  }

  @keyframes crimsonPulse {
    0%, 100% { box-shadow: 0 0 5px rgba(215, 38, 61, 0.18); }
    50% { box-shadow: 0 0 16px rgba(215, 38, 61, 0.52); }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-button, .filter-button.active, .small-button.open, .photo-cache-button { animation: none !important; }
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
  }

  button, input, select { font: inherit; }

  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  summary:focus-visible {
    outline: 3px solid rgba(215, 38, 61, 0.62);
    outline-offset: 2px;
  }

  .release-bar {
    background: #1f7a3d;
    color: white;
    padding: 11px 16px;
    text-align: center;
    font-weight: 800;
    line-height: 1.35;
  }

  header {
    background: linear-gradient(135deg, #9e1b32, #5e0b18);
    padding: 28px 18px;
    text-align: center;
    box-shadow: 0 8px 28px rgba(94, 11, 24, 0.42), 0 0 22px rgba(215, 38, 61, 0.18);
  }

  header h1 {
    margin: 0;
    font-size: clamp(2rem, 7vw, 2.8rem);
  }

  header p {
    margin: 9px auto 0;
    max-width: 720px;
    line-height: 1.5;
  }

  .container {
    padding: 18px;
    max-width: 1050px;
    margin: auto;
  }

  .status-row,
  .stats-grid,
  .filter-row,
  .grid {
    display: grid;
    gap: 12px;
  }

  .status-row {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 14px;
  }

  .status-chip {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 11px 13px;
    color: var(--muted);
    font-weight: 700;
  }

  .status-chip strong { color: var(--text); }
  .status-chip.online { border-left: 5px solid var(--green); }
  .status-chip.offline { border-left: 5px solid var(--yellow); }

  .stats-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-bottom: 18px;
  }

  .stat-card {
    background: linear-gradient(145deg, #223140, #182430);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 14px;
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 1.45rem;
    font-weight: 900;
    color: var(--gold);
  }

  .stat-label {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .search-row {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
  }

  .search-box {
    width: 100%;
    min-width: 0;
    padding: 14px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: white;
    color: #111;
    font-size: 1rem;
  }

  .primary-button,
  .secondary-button,
  .filter-button,
  .small-button,
  .favorite-button,
  .close-button {
    border: none;
    border-radius: 10px;
    cursor: pointer;
    font-weight: 800;
    min-height: 44px;
  }

  .primary-button {
    padding: 0 18px;
    background: linear-gradient(135deg, #9e1b32, #5e0b18);
    color: white;
    animation: crimsonPulse 2.4s ease-in-out infinite;
  }

  .secondary-button,
  .close-button {
    padding: 0 16px;
    background: #334454;
    color: white;
  }

  .primary-button:active,
  .secondary-button:active,
  .filter-button:active,
  .small-button:active,
  .favorite-button:active,
  .close-button:active { transform: scale(0.98); }


  .quick-trades {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    margin: 4px 0 16px;
  }

  .quick-trade-button {
    min-width: 0;
    min-height: 76px;
    border: 1px solid #6f2532;
    border-radius: 12px;
    background: #182430;
    color: #f5f7f9;
    cursor: pointer;
    padding: 10px 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .quick-trade-button .quick-icon {
    font-size: 1.7rem;
    line-height: 1;
  }

  .quick-trade-button .quick-label {
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
  }

  .quick-trade-button:hover,
  .quick-trade-button:focus-visible {
    background: #21303d;
    border-color: #d7263d;
    box-shadow: 0 0 14px rgba(215, 38, 61, 0.26);
  }

  .quick-trade-button:active { transform: scale(0.97); }

  @media (max-width: 760px) {
    .quick-trades { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 430px) {
    .quick-trades { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .quick-trade-button { min-height: 70px; padding: 9px 4px; }
    .quick-trade-button .quick-icon { font-size: 1.55rem; }
    .quick-trade-button .quick-label { font-size: 0.72rem; }
  }

  .filter-panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 12px;
    margin-bottom: 18px;
  }

  .filter-row {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .filter-button,
  .filter-select {
    width: 100%;
    min-height: 44px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #263746;
    color: white;
    padding: 0 10px;
  }

  .filter-button.active {
    background: linear-gradient(135deg, #9e1b32, #5e0b18);
    border-color: transparent;
    animation: crimsonPulse 2.4s ease-in-out infinite;
  }

  .filter-hint {
    margin: 10px 2px 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.45;
  }

  .grid {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .trade-card {
    background: #1f2a36;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    text-align: center;
    cursor: pointer;
    color: white;
    transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
  }

  .trade-card:hover {
    background: #263747;
    border-color: #58738a;
    transform: translateY(-2px);
  }

  .trade-card h2 {
    font-size: 1.1rem;
    margin: 10px 0 5px;
  }

  .trade-card p {
    color: var(--muted);
    margin-bottom: 0;
  }

  .emoji { font-size: 2rem; }

  .panel {
    margin-top: 25px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    display: none;
    box-shadow: var(--shadow);
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }

  .panel h2 {
    color: var(--gold);
    margin: 0 0 8px;
  }

  .guide-count {
    color: #c9d3dc;
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .no-results {
    background: var(--surface-2);
    border-radius: 10px;
    padding: 16px;
    line-height: 1.55;
  }

  .guide-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin: 12px 0;
    overflow: hidden;
  }

  .guide-summary {
    display: grid;
    grid-template-columns: 145px 1fr;
    gap: 14px;
    padding: 12px;
    align-items: stretch;
  }

  .part-picture {
    position: relative;
    min-height: 125px;
    border-radius: 10px;
    border: 1px solid #4b6172;
    background: linear-gradient(145deg, #31485b, #16222d);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    overflow: hidden;
    color: white;
  }

  button.part-picture {
    width: 100%;
    cursor: zoom-in;
    text-align: left;
  }

  .part-picture svg {
    width: 100%;
    height: 100%;
    max-height: 160px;
    padding: 8px;
  }

  .part-photo {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 125px;
    max-height: 180px;
    object-fit: contain;
    background: #14212b;
  }

  .photo-badge {
    position: absolute;
    left: 8px;
    bottom: 8px;
    max-width: calc(100% - 16px);
    padding: 5px 8px;
    border-radius: 999px;
    background: rgba(8, 15, 22, 0.86);
    color: white;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    backdrop-filter: blur(4px);
  }

  .photo-cache-button {
    margin-top: 9px;
    padding: 0 11px;
    min-height: 36px;
    border: none;
    border-radius: 9px;
    background: linear-gradient(135deg, #9e1b32, #5e0b18);
    color: white;
    cursor: pointer;
    font-weight: 900;
    animation: crimsonPulse 2.4s ease-in-out infinite;
  }

  .photo-modal[hidden] { display: none; }

  .photo-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 18px;
    background: rgba(0, 0, 0, 0.84);
  }

  .photo-modal-card {
    position: relative;
    width: min(920px, 100%);
    max-height: calc(100vh - 36px);
    overflow: auto;
    border: 1px solid #60788d;
    border-radius: 16px;
    background: #111c25;
    box-shadow: 0 24px 70px rgba(0,0,0,.55);
  }

  .photo-modal-image {
    display: block;
    width: 100%;
    max-height: 72vh;
    object-fit: contain;
    background: #071018;
  }

  .photo-modal-info {
    padding: 14px 16px 18px;
  }

  .photo-modal-info h2 {
    margin: 0 0 7px;
    color: var(--gold);
  }

  .photo-modal-info p {
    margin: 5px 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .photo-modal-info a,
  .photo-credits a {
    color: #8fc7ff;
  }

  .photo-modal-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255,255,255,.25);
    border-radius: 50%;
    background: rgba(10,18,25,.9);
    color: white;
    cursor: pointer;
    font-size: 1.3rem;
    font-weight: 900;
  }

  .photo-credits {
    max-width: 940px;
    margin: 12px auto 0;
    padding: 0 16px;
    text-align: left;
  }

  .photo-credits summary {
    cursor: pointer;
    color: #d4dde5;
    font-weight: 800;
  }

  .photo-credit-list {
    margin-top: 10px;
    padding: 12px;
    border: 1px solid #34485a;
    border-radius: 10px;
    background: #111c25;
    line-height: 1.45;
  }

  .photo-credit-list p {
    margin: 7px 0;
  }

  .guide-heading-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: flex-start;
  }

  .guide-title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .trade-label {
    display: inline-block;
    margin-bottom: 7px;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .guide-symptom {
    margin: 8px 0 0;
    color: #e7edf2;
    line-height: 1.45;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 11px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 4px 9px;
    border-radius: 999px;
    font-size: 0.77rem;
    font-weight: 900;
    border: 1px solid rgba(255,255,255,0.13);
    background: #182631;
  }

  .difficulty-easy { color: #8ce6b0; }
  .difficulty-moderate { color: #ffe29a; }
  .difficulty-advanced { color: #ff8f93; }
  .cost-badge { color: #9dd1ff; }

  .guide-actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  .small-button,
  .favorite-button {
    padding: 0 12px;
    background: #334454;
    color: white;
  }

  .small-button.open {
    background: linear-gradient(135deg, #9e1b32, #5e0b18);
    animation: crimsonPulse 2.4s ease-in-out infinite;
  }

  .favorite-button {
    min-width: 46px;
    font-size: 1.1rem;
  }

  .favorite-button.saved {
    background: #6d5013;
    color: #ffd166;
  }

  .guide-body {
    border-top: 1px solid var(--border);
    padding: 12px;
    background: #1b2a36;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  .detail-box {
    background: #182631;
    border-left: 4px solid var(--orange);
    box-shadow: inset 2px 0 0 rgba(215, 38, 61, 0.18);
    border-radius: 8px;
    padding: 10px;
    line-height: 1.45;
  }

  .detail-box b {
    display: block;
    color: var(--gold);
    margin-bottom: 4px;
  }

  .safety-low { border-left-color: var(--green); }
  .safety-medium { border-left-color: var(--yellow); }
  .safety-high { border-left-color: var(--red); }

  .repair-note {
    margin-top: 10px;
    padding: 10px;
    border-radius: 8px;
    background: var(--surface-3);
    color: #e7edf2;
    line-height: 1.45;
  }

  .body-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%) translateY(20px);
    background: #111c25;
    color: white;
    border: 1px solid #4b6172;
    box-shadow: var(--shadow);
    border-radius: 10px;
    padding: 12px 16px;
    opacity: 0;
    pointer-events: none;
    transition: 0.2s ease;
    z-index: 20;
    max-width: calc(100vw - 32px);
    text-align: center;
  }

  .toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  footer {
    text-align: center;
    padding: 22px;
    color: #aaa;
    font-size: 0.9rem;
  }

  #topBtn {
    position: fixed;
    right: 18px;
    bottom: 18px;
    background: var(--orange);
    color: white;
    border: none;
    border-radius: 50%;
    width: 54px;
    height: 54px;
    font-size: 24px;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0,0,0,.4);
    z-index: 10;
  }

  @media (max-width: 760px) {
    .filter-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .filter-row > :last-child { grid-column: span 2; }
  }

  @media (max-width: 620px) {
    .search-row { flex-wrap: wrap; }
    .search-box { flex-basis: 100%; }
    .primary-button, .secondary-button { flex: 1; min-height: 46px; }
    .guide-summary { grid-template-columns: 1fr; }
    .part-picture { min-height: 155px; }
    .detail-grid { grid-template-columns: 1fr; }
    .status-row { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 430px) {
    .stats-grid { grid-template-columns: 1fr; }
    .photo-modal { padding: 8px; }
    .photo-modal-card { max-height: calc(100vh - 16px); }
    .filter-row { grid-template-columns: 1fr; }
    .filter-row > :last-child { grid-column: auto; }
    .panel-header { flex-direction: column; }
    .close-button { width: 100%; }
  }

  /* =========================================================
     TRADESTACK v1.6 HYBRID THEME
     Electric blue + cyan + violet branding
     Multicolor guide/status accents preserved
     ========================================================= */
  :root {
    --bg: #0b0b0b;
    --surface: #151515;
    --surface-2: #1f1f1f;
    --surface-3: #292929;
    --border: #3a3a3a;
    --text: #f5f7f9;
    --muted: #b8c8d4;
    --orange: #00e5ff;
    --orange-2: #2979ff;
    --crimson-glow: #7c4dff;
    --gold: #ffbf69;
    --green: #55c98a;
    --yellow: #ffd166;
    --red: #ff5a5f;
