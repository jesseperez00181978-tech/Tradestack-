function handlePhotoError(image) {
  const current = image.currentSrc || image.src || "";

  // Wikimedia can occasionally fail on the first request in a local-file build.
  // Retry the SAME real photo once before falling back to an illustrated card.
  if (!image.dataset.retryDone && /^https:\/\/commons\.wikimedia\.org\//i.test(current)) {
    image.dataset.retryDone = "true";
    const sep = current.includes("?") ? "&" : "?";
    image.src = current + sep + "retry=1";
    return;
  }

  const fallbacks = (image.dataset.photoFallbacks || "").split("|||").filter(Boolean);
  const index = Number(image.dataset.fallbackIndex || "0");

  if (index < fallbacks.length) {
    const nextUrl = fallbacks[index];
    image.dataset.fallbackIndex = String(index + 1);
    image.dataset.photoUrl = nextUrl;
    image.src = nextUrl;
    return;
  }

  const holder = image.closest(".part-picture");
  if (!holder || holder.dataset.fallbackShown === "true") return;
  holder.dataset.fallbackShown = "true";
  holder.classList.remove("photo-trigger");
  holder.removeAttribute("data-photo-key");
  holder.innerHTML = createPartPicture(
    image.dataset.label || "Component",
    image.dataset.trade || "",
    image.dataset.unique || "fallback"
  );
}

function allGuideResults() {
  const results = [];
  Object.entries(guides).forEach(([tradeKey, trade]) => {
    trade.steps.forEach((step, originalIndex) => {
      const details = getGuideDetails(step, tradeKey);
      results.push({
        id: guideId(tradeKey, step),
        tradeKey,
        tradeTitle: tradeName(tradeKey),
        step,
        originalIndex,
        details
      });
    });
  });
  return results;
}

const guideIndex = allGuideResults();
const guideMap = new Map(guideIndex.map(result => [result.id, result]));

function searchText(result) {
  const d = result.details;
  return normalizeText([
    result.tradeKey,
    result.tradeTitle,
    result.step.problem,
    result.step.symptom,
    result.step.fix,
    d.cause,
    d.parts,
    d.tools,
    d.picture,
    d.cost,
    d.costTier,
    d.difficulty,
    d.safety
  ].join(" "));
}

function getCurrentResults() {
  let results;

  if (state.view === "favorites") {
    results = guideIndex.filter(result => favorites.has(result.id));
  } else if (state.view === "recent") {
    results = recent.map(id => guideMap.get(id)).filter(Boolean);
  } else if (state.view === "trade" && state.trade) {
    results = guideIndex.filter(result => result.tradeKey === state.trade);
  } else if (state.view === "search" && state.query) {
    const terms = normalizeText(state.query).split(/\s+/).filter(Boolean);
    results = guideIndex.filter(result => {
      const haystack = searchText(result);
      return terms.every(term => haystack.includes(term));
    });
  } else {
    results = guideIndex.slice();
  }

  if (state.difficulty !== "all") {
    results = results.filter(result => result.details.difficulty === state.difficulty);
  }

  if (state.cost !== "all") {
    results = results.filter(result => result.details.costTier === state.cost);
  }

  return results;
}

function viewTitle() {
  if (state.view === "favorites") return "Favorite Guides";
  if (state.view === "recent") return "Recently Opened Guides";
  if (state.view === "trade" && state.trade) return guides[state.trade].title;
  if (state.view === "search") return `Search Results for "${state.query}"`;
  return "All Troubleshooting Guides";
}

function activeFilterText() {
  const filters = [];
  if (state.difficulty !== "all") filters.push(state.difficulty);
  if (state.cost !== "all") filters.push(`${state.cost} cost`);
  return filters.length ? ` - Filtered by ${filters.join(" + ")}` : "";
}

