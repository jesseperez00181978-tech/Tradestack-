<script id="tradestack-ai-v111-js">
(() => {
  const $ = id => document.getElementById(id);
  const panel=$('tsAiPanel'), fab=$('tsAiFab'), body=$('tsAiBody'), input=$('tsAiInput'), send=$('tsAiSend'), status=$('tsAiStatus');
  const STORE='tradestack_ai_v111_chat';
  const stop=new Set('a an and are as at be been but by can could do does for from had has have how i if in into is it its me my of on or our should so than that the their then there they this to was we what when where which with you your wont will not no'.split(' '));
  const synonyms={
    'ac':['hvac','air conditioner','cooling','condenser','evaporator'], 'air':['hvac'], 'furnace':['hvac','heat'], 'heater':['hvac','heat'],
    'sprinkler':['irrigation','zone','valve','head'], 'sprinklers':['irrigation','zone','valve','head'], 'drip':['irrigation','emitter'],
    'breaker':['electrical','circuit','trip'], 'outlet':['electrical','receptacle'], 'gfci':['electrical','outlet'],
    'toilet':['plumbing'], 'faucet':['plumbing'], 'drain':['plumbing','clog'], 'pipe':['plumbing'],
    'car':['automotive','vehicle'], 'truck':['automotive','vehicle'], 'battery':['automotive','electrical'],
    'mower':['small engines','smallengines','engine'], 'trimmer':['small engines','smallengines','engine'], 'blower':['small engines','smallengines','engine'],
    'deck':['carpentry'], 'door':['carpentry'], 'cabinet':['carpentry'],
    'grass':['landscaping'], 'lawn':['landscaping'], 'plant':['landscaping'], 'tree':['landscaping']
  };
  const escape=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
  const normalize=s=>String(s??'').toLowerCase().replace(/[^a-z0-9$+.-]+/g,' ').replace(/\s+/g,' ').trim();
  const tokens=s=>{
    const out=[]; for(const t of normalize(s).split(' ')){if(!t||stop.has(t)||t.length<2)continue;out.push(t);(synonyms[t]||[]).forEach(x=>out.push(...normalize(x).split(' ')));}
    return [...new Set(out)];
  };
  function availableGuides(){ try{return (typeof guideIndex!=='undefined'&&Array.isArray(guideIndex))?guideIndex:[]}catch(e){return[]} }
  function hay(g){
    try{return normalize([g.tradeKey,g.tradeTitle,g.step?.problem,g.step?.symptom,g.step?.fix,g.details?.cause,g.details?.parts,g.details?.tools,g.details?.picture,g.details?.safety,g.details?.note].join(' '))}catch(e){return ''}
  }
  function rank(q,limit=4){
    const list=availableGuides(), ts=tokens(q), nq=normalize(q);
    return list.map(g=>{
      const h=hay(g), p=normalize(g.step?.problem), s=normalize(g.step?.symptom), tr=normalize(g.tradeTitle||g.tradeKey), c=normalize(g.details?.cause);
      let score=0; if(nq&&p.includes(nq))score+=28;if(nq&&s.includes(nq))score+=18;
      for(const t of ts){if(p.includes(t))score+=8;if(s.includes(t))score+=6;if(tr.includes(t))score+=5;if(c.includes(t))score+=3;if(h.includes(t))score+=1;}
      const matched=ts.filter(t=>h.includes(t)).length; score += matched*matched*1.6;
      return {g,score};
    }).filter(x=>x.score>0).sort((a,b)=>b.score-a.score).slice(0,limit).map(x=>x.g);
  }
  function save(){try{localStorage.setItem(STORE,body.innerHTML)}catch(e){}}
  function restore(){try{let h=localStorage.getItem(STORE);if(h){body.innerHTML=h;wireGuideButtons();return true}}catch(e){}return false}
  function scrollEnd(){body.scrollTop=body.scrollHeight}
  function addMsg(html,kind='bot'){const d=document.createElement('div');d.className='tsai-msg '+kind;d.innerHTML=html;body.appendChild(d);scrollEnd();save();return d}
  function welcome(){addMsg('<div class="tsai-kicker">FIELD ASSISTANT</div><b>Describe what the equipment is doing.</b> I’ll match the symptom against TradeStack’s built-in guides, show likely causes and safety notes, and take you to the closest guide.<br><br><small>I won’t guess past the guide data when a test or measurement is needed.</small>');}
  function guideCard(g,i){
    const d=g.details||{}, step=g.step||{}, id=escape(g.id), trade=escape(g.tradeTitle||g.tradeKey||'Trade');
    return `<div class="tsai-guide"><b>${i+1}. ${escape(step.problem||'Matching guide')}</b><small>${trade} • ${escape(d.difficulty||'')} • DIY ${escape(d.cost||'')}</small>${d.cause?`<div class="tsai-cause"><b style="display:inline">Likely cause:</b> ${escape(d.cause)}</div>`:''}${d.safety?`<div class="tsai-safety"><b>⚠ Safety</b><br>${escape(d.safety)}</div>`:''}<div class="tsai-actions"><button class="tsai-btn primary" data-tsai-open="${id}" type="button">Open guide</button><button class="tsai-btn" data-tsai-search="${escape(step.problem||'')}" type="button">Search related</button></div></div>`;
  }
  function localReply(q){
    const hits=rank(q,4);
    if(!hits.length){return `<b>I couldn't match that cleanly yet.</b><br>Give me the equipment plus the symptom, for example: <i>“gas furnace igniter glows but burners don’t light”</i> or <i>“sprinkler zone 4 has low pressure.”</i><div class="tsai-actions"><button class="tsai-btn" data-tsai-field="1" type="button">Open Field Assist</button></div>`;}
    const first=hits[0], d=first.details||{}, s=first.step||{};
    let intro=`<div class="tsai-kicker">BEST MATCH</div><b>${escape(s.problem||'Guide match')}</b>`;
    if(s.symptom)intro+=`<br><span style="color:#b8c8d4">${escape(s.symptom)}</span>`;
    if(d.cause)intro+=`<br><br><b>Start by checking:</b> ${escape(d.cause)}`;
    if(d.tools)intro+=`<br><br><b>Useful tools:</b> ${escape(d.tools)}`;
    intro+=`<br><br><b>Matching TradeStack guides:</b>`+hits.map(guideCard).join('');
    intro+=`<div class="tsai-actions"><button class="tsai-btn gold" data-tsai-field="1" type="button">Open Field Assist</button></div>`;
    return intro;
  }
  function contextFor(q){return rank(q,5).map(g=>({id:g.id,trade:g.tradeTitle||g.tradeKey,problem:g.step?.problem,symptom:g.step?.symptom,fix:g.step?.fix,cause:g.details?.cause,parts:g.details?.parts,tools:g.details?.tools,safety:g.details?.safety,difficulty:g.details?.difficulty,cost:g.details?.cost}));}
  async function cloudReply(q){
    const ep=window.TRADESTACK_AI_ENDPOINT; if(!ep)return null;
    status.innerHTML='<span class="tsai-dot"></span>Secure cloud assistant connected.';
    try{
      const r=await fetch(ep,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:q,app:'TradeStack',version:'1.11',context:contextFor(q)})});
      if(!r.ok)throw new Error('HTTP '+r.status); const j=await r.json(); const ans=j.answer||j.message||j.output;
      return ans?escape(ans).replace(/\n/g,'<br>'):null;
    }catch(e){status.textContent='Cloud assistant unavailable • using built-in TradeStack guide intelligence.';return null}
  }
  async function ask(raw){
    const q=String(raw||'').trim(); if(!q)return; addMsg(escape(q),'user'); input.value=''; input.style.height='46px';
    const wait=addMsg('Checking TradeStack guides…','bot');
    const remote=await cloudReply(q); wait.remove(); addMsg(remote||localReply(q),'bot'); wireGuideButtons();save();
  }
  function openGuide(id){
    try{
      const g=(typeof guideMap!=='undefined'&&guideMap.get)?guideMap.get(id):null;
      if(!g)return;
      if(typeof setView==='function'){state.view='search';state.trade=null;state.query=g.step.problem;const s=document.getElementById('search');if(s)s.value=g.step.problem;renderCurrentView();}
      panel.classList.remove('open');panel.setAttribute('aria-hidden','true');
      setTimeout(()=>{const card=[...document.querySelectorAll('.guide-card')].find(x=>x.dataset.guideId===id);if(card){card.scrollIntoView({behavior:'smooth',block:'center'});const b=card.querySelector('[data-action="expand"]');if(b&&b.getAttribute('aria-expanded')!=='true')b.click();}},140);
    }catch(e){console.warn('AI open guide',e)}
  }
  function searchRelated(q){const s=document.getElementById('search');if(s){s.value=q;if(typeof runSearch==='function')runSearch();s.scrollIntoView({behavior:'smooth',block:'center'});}panel.classList.remove('open');panel.setAttribute('aria-hidden','true');}
  function openFieldAssist(){panel.classList.remove('open');panel.setAttribute('aria-hidden','true');const b=document.getElementById('diagStart');if(b){b.scrollIntoView({behavior:'smooth',block:'center'});setTimeout(()=>b.click(),250)}}
  function wireGuideButtons(){body.querySelectorAll('[data-tsai-open]').forEach(b=>b.onclick=()=>openGuide(b.dataset.tsaiOpen));body.querySelectorAll('[data-tsai-search]').forEach(b=>b.onclick=()=>searchRelated(b.dataset.tsaiSearch));body.querySelectorAll('[data-tsai-field]').forEach(b=>b.onclick=openFieldAssist)}
  function open(){panel.classList.add('open');panel.setAttribute('aria-hidden','false');setTimeout(()=>input.focus(),60)}
  function close(){panel.classList.remove('open');panel.setAttribute('aria-hidden','true')}
  fab.onclick=()=>panel.classList.contains('open')?close():open();$('tsAiClose').onclick=close;
  $('tsAiClear').onclick=()=>{try{localStorage.removeItem(STORE)}catch(e){}body.innerHTML='';welcome();wireGuideButtons()};
  send.onclick=()=>ask(input.value); input.addEventListener('keydown',e=>{if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();ask(input.value)}});input.addEventListener('input',()=>{input.style.height='46px';input.style.height=Math.min(input.scrollHeight,110)+'px'});
  $('tsAiQuick').querySelectorAll('button').forEach(b=>b.onclick=()=>ask(b.textContent));
  if(!restore())welcome(); wireGuideButtons();
  window.TradeStackAI={open,close,ask,rankGuides:rank,version:'1.11'};
})();
</script>


