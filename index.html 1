Remodel rule:&lt;/b&gt; A beautiful finish cannot rescue bad rough-in work hiding behind it. Structural changes, new electrical circuits, regulated plumbing/gas work, and complex waterproofing must follow applicable permits, codes, manufacturer systems, and qualified-trade requirements.&lt;/div&gt;\n&lt;label class=\&quot;done\&quot;&gt;&lt;input type=\&quot;checkbox\&quot; data-id=\&quot;remodel-20\&quot; onchange=\&quot;saveProgress(this)\&quot;&gt; Mark guide complete&lt;/label&gt;&lt;/div&gt;&lt;/article&gt;&lt;footer&gt;Educational field reference. Approved plans, permits, inspections, manufacturer requirements, and licensed-trade rules control actual remodel work.&lt;/footer&gt;&lt;/div&gt;\n&lt;script&gt;let currentCat='ALL';function toggleGuide(b){b.closest('.guide').classList.toggle('open')}function filterCat(c){currentCat=c;applyFilters()}function applyFilters(){let q=document.getElementById('search').value.toLowerCase();document.querySelectorAll('.guide').forEach(g=&gt;g.style.display=((currentCat==='ALL'||g.dataset.cat===currentCat)&amp;&amp;g.dataset.title.includes(q))?'block':'none')}function saveProgress(e){localStorage.setItem(e.dataset.id,e.checked?'1':'0');updateProgress()}function updateProgress(){let n=0;document.querySelectorAll('.done input').forEach(x=&gt;{if(x.checked)n++});document.getElementById('progress').textContent=n+'/20 Complete'}document.querySelectorAll('.done input').forEach(x=&gt;x.checked=localStorage.getItem(x.dataset.id)==='1');updateProgress();&lt;\/script&gt;&lt;/body&gt;&lt;/html&gt;&quot;}, {&quot;emoji&quot;: &quot;🏘️&quot;, &quot;title&quot;: &quot;Home Inspection Basics&quot;, &quot;file&quot;: &quot;tradestack-premium-home-inspection-basics-v1.html&quot;, &quot;html&quot;: &quot;&lt;!doctype html&gt;&lt;html&gt;&lt;head&gt;&lt;meta charset=\&quot;utf-8\&quot;&gt;&lt;meta name=\&quot;viewport\&quot; content=\&quot;width=device-width,initial-scale=1\&quot;&gt;&lt;title&gt;TradeStack Premium — Home Inspection Basics v1&lt;