          </div>
        </div>
      </div>
      <div class="guide-body" hidden>
        <div class="detail-grid">
          <div class="detail-box"><b>Repair steps</b>${escapeHtml(step.fix)}</div>
          <div class="detail-box"><b>Most likely cause</b>${escapeHtml(details.cause)}</div>
          <div class="detail-box"><b>Parts possibly needed</b>${escapeHtml(details.parts)}</div>
          <div class="detail-box"><b>Tools needed</b>${escapeHtml(details.tools)}</div>
          <div class="detail-box"><b>Typical DIY cost</b>${escapeHtml(details.cost)} in parts or materials. Labor not included.</div>
          <div class="detail-box ${safetyClass}"><b>Safety level: ${escapeHtml(details.safety)}</b>${details.safety === "High" ? "Disconnect power, fuel, pressure, or water before testing. Use qualified service when required." : "Use PPE and isolate the system before repair."}</div>
